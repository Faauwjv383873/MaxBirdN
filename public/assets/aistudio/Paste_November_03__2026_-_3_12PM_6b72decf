CREATE OR REPLACE FUNCTION public.get_required_app_version_name()
 RETURNS text
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_ver TEXT;
BEGIN
    SELECT NULLIF(BTRIM(REGEXP_REPLACE(COALESCE(latest_version_name, ''), '^[vV]', '')), '')
    INTO v_ver
    FROM public.app_updates
    WHERE is_active = true
    ORDER BY created_at DESC
    LIMIT 1;

    RETURN COALESCE(v_ver, '');
END;
$function$
;

CREATE OR REPLACE FUNCTION public.check_student_verification_status(p_device_hash text, p_display_device_id text DEFAULT ''::text, p_device_model text DEFAULT ''::text, p_device_brand text DEFAULT ''::text, p_android_version text DEFAULT ''::text, p_app_version text DEFAULT ''::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_dev RECORD;
    v_req_ver TEXT := public.get_required_app_version_name();
    v_client_ver TEXT := NULLIF(BTRIM(REGEXP_REPLACE(COALESCE(p_app_version, ''), '^[vV]', '')), '');
BEGIN
    -- যদি ক্লায়েন্ট ভার্সন পাঠায় এবং সেটি ডাটাবেজের নির্ধারিত ভার্সনের সাথে না মেলে, সাথে সাথে ব্লক মেসেজ রিটার্ন করবে
    IF v_req_ver <> '' AND v_client_ver IS NOT NULL AND LOWER(v_client_ver) <> LOWER(v_req_ver) THEN
        RETURN jsonb_build_object(
            'status', 'blocked',
            'is_banned', true,
            'is_blocked', true,
            'is_approved', false,
            'can_view_profiles', false,
            'ban_reason', 'পুরাতন ভার্সনের অ্যাপ (v' || v_client_ver || ') ব্যবহার করা যাবে না! শুধুমাত্র নির্ধারিত ভার্সন (v' || v_req_ver || ') ইনস্টল করে ব্যবহার করুন।'
        );
    END IF;

    SELECT * INTO v_dev
    FROM public.devices
    WHERE device_hash = p_device_hash
       OR device_id = p_device_hash
       OR (p_display_device_id <> '' AND display_device_id = p_display_device_id)
    LIMIT 1;

    IF v_dev IS NULL THEN
        RETURN jsonb_build_object(
            'status', 'unverified',
            'is_banned', false,
            'is_approved', false,
            'can_view_profiles', false
        );
    END IF;

    -- ক্লায়েন্টের বর্তমান ভার্সন ডাটাবেজে আপডেট রাখা
    IF v_client_ver IS NOT NULL AND COALESCE(v_dev.app_version, '') <> v_client_ver THEN
        UPDATE public.devices SET app_version = v_client_ver, last_seen = NOW() WHERE id = v_dev.id;
    END IF;

    IF v_dev.is_banned = true OR v_dev.is_blocked = true OR LOWER(COALESCE(v_dev.status, '')) IN ('banned', 'blocked', 'rejected', 'suspended', 'revoked') THEN
        RETURN jsonb_build_object(
            'status', 'banned',
            'is_banned', true,
            'is_approved', false,
            'can_view_profiles', false,
            'ban_reason', COALESCE(NULLIF(v_dev.ban_reason, ''), NULLIF(v_dev.rejection_reason, ''), 'এই ডিভাইসে প্রবেশাধিকার স্থগিত করা হয়েছে।')
        );
    END IF;

    IF LOWER(COALESCE(v_dev.status, '')) IN ('active', 'approved') THEN
        RETURN jsonb_build_object(
            'status', 'active',
            'is_banned', false,
            'is_approved', true,
            'session_token', COALESCE(NULLIF(v_dev.session_token, ''), 'VERIFIED-' || p_device_hash),
            'applied_code', COALESCE(v_dev.applied_code, 'VERIFIED-DEVICE'),
            'student_note', COALESCE(v_dev.student_note, v_dev.student_name, ''),
            'can_view_profiles', COALESCE(v_dev.can_view_profiles, false),
            'is_access_restricted', COALESCE(v_dev.is_access_restricted, false),
            'allowed_classes', COALESCE(v_dev.allowed_classes, '{}'::text[]),
            'allowed_groups', COALESCE(v_dev.allowed_groups, '{}'::text[]),
            'allowed_batches', COALESCE(v_dev.allowed_batches, '{}'::text[]),
            'allowed_programs', COALESCE(v_dev.allowed_programs, '{}'::text[]),
            'bound_shikho_user_id', COALESCE(v_dev.bound_shikho_user_id, ''),
            'bound_user_phone', COALESCE(v_dev.bound_user_phone, '')
        );
    END IF;

    RETURN jsonb_build_object(
        'status', COALESCE(NULLIF(v_dev.status, ''), 'pending'),
        'is_banned', false,
        'is_approved', false,
        'can_view_profiles', false,
        'student_note', COALESCE(v_dev.student_note, v_dev.student_name, '')
    );
END;
$function$
;

CREATE OR REPLACE FUNCTION public.get_student_course_commerce_status(p_device_id text DEFAULT ''::text, p_shikho_account_key text DEFAULT ''::text, p_shikho_user_id text DEFAULT ''::text, p_user_phone text DEFAULT ''::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_dev text := TRIM(COALESCE(p_device_id, ''));
    v_acc text := TRIM(COALESCE(p_shikho_account_key, ''));
    v_uid text := TRIM(COALESCE(p_shikho_user_id, ''));
    v_phn text := RIGHT(REGEXP_REPLACE(COALESCE(p_user_phone, ''), '[^0-9]', '', 'g'), 11);
    v_settings jsonb;
    v_enrollments jsonb;
    v_transactions jsonb;
BEGIN
    -- মেয়াদোত্তীর্ণ ফ্রি ট্রায়াল ও কিস্তি অটো-ব্লক করা
    PERFORM public.enforce_overdue_course_installments();

    SELECT to_jsonb(s) INTO v_settings
    FROM public.course_payment_settings s
    ORDER BY id ASC
    LIMIT 1;

    SELECT COALESCE(jsonb_agg(to_jsonb(e) ORDER BY e.updated_at DESC), '[]'::jsonb)
    INTO v_enrollments
    FROM public.course_access_enrollments e
    WHERE (v_dev <> '' AND (e.device_id = v_dev OR e.device_hash = v_dev))
       OR (v_acc <> '' AND (e.shikho_account_key = v_acc OR e.device_id = v_acc))
       OR (v_uid <> '' AND e.shikho_user_id = v_uid)
       OR (v_phn <> '' AND LENGTH(v_phn) >= 11 AND (
           RIGHT(REGEXP_REPLACE(COALESCE(e.user_phone, ''), '[^0-9]', '', 'g'), 11) = v_phn
           OR RIGHT(REGEXP_REPLACE(COALESCE(e.student_phone, ''), '[^0-9]', '', 'g'), 11) = v_phn
       ));

    SELECT COALESCE(jsonb_agg(to_jsonb(t) ORDER BY t.created_at DESC), '[]'::jsonb)
    INTO v_transactions
    FROM public.course_payment_transactions t
    WHERE (v_dev <> '' AND (t.device_id = v_dev OR t.device_hash = v_dev))
       OR (v_acc <> '' AND t.shikho_account_key = v_acc)
       OR (v_uid <> '' AND t.shikho_user_id = v_uid)
       OR (v_phn <> '' AND LENGTH(v_phn) >= 11 AND (
           RIGHT(REGEXP_REPLACE(COALESCE(t.user_phone, ''), '[^0-9]', '', 'g'), 11) = v_phn
           OR RIGHT(REGEXP_REPLACE(COALESCE(t.student_phone, ''), '[^0-9]', '', 'g'), 11) = v_phn
       ));

    RETURN jsonb_build_object(
        'success', true,
        'payment_settings', COALESCE(v_settings, '{}'::jsonb),
        'enrollments', COALESCE(v_enrollments, '[]'::jsonb),
        'transactions', COALESCE(v_transactions, '[]'::jsonb)
    );
END;
$function$
;

CREATE OR REPLACE FUNCTION public.sync_student_push_identity(p_device_hash text, p_display_device_id text DEFAULT ''::text, p_student_phone text DEFAULT ''::text, p_student_key text DEFAULT ''::text, p_onesignal_player_id text DEFAULT ''::text, p_fcm_token text DEFAULT ''::text, p_app_version text DEFAULT ''::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
  v_hash TEXT := TRIM(COALESCE(p_device_hash, ''));
  v_disp TEXT := TRIM(COALESCE(p_display_device_id, ''));
  v_phone TEXT := RIGHT(REGEXP_REPLACE(COALESCE(p_student_phone, ''), '[^0-9]', '', 'g'), 11);
  v_player TEXT := TRIM(COALESCE(p_onesignal_player_id, ''));
  v_fcm TEXT := TRIM(COALESCE(p_fcm_token, ''));
  v_ver TEXT := TRIM(COALESCE(p_app_version, ''));
BEGIN
  IF v_hash = '' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Missing device_hash');
  END IF;

  UPDATE public.devices
  SET
    onesignal_player_id = CASE WHEN v_player <> '' THEN v_player ELSE onesignal_player_id END,
    fcm_token = CASE WHEN v_fcm <> '' THEN v_fcm ELSE fcm_token END,
    student_phone = CASE WHEN LENGTH(v_phone) >= 11 THEN v_phone ELSE student_phone END,
    app_version = CASE WHEN v_ver <> '' THEN v_ver ELSE app_version END,
    last_seen = NOW(),
    updated_at = NOW()
  WHERE device_hash = v_hash
     OR device_id = v_hash
     OR (v_disp <> '' AND display_device_id = v_disp);

  UPDATE public.course_access_enrollments
  SET
    onesignal_player_id = CASE WHEN v_player <> '' THEN v_player ELSE onesignal_player_id END,
    fcm_token = CASE WHEN v_fcm <> '' THEN v_fcm ELSE fcm_token END,
    updated_at = NOW()
  WHERE device_id = v_hash
     OR device_hash = v_hash
     OR (LENGTH(v_phone) >= 11 AND (
         RIGHT(REGEXP_REPLACE(COALESCE(student_phone, ''), '[^0-9]', '', 'g'), 11) = v_phone
         OR RIGHT(REGEXP_REPLACE(COALESCE(user_phone, ''), '[^0-9]', '', 'g'), 11) = v_phone
     ));

  RETURN jsonb_build_object('success', true);
END;
$function$
;

CREATE OR REPLACE FUNCTION public.update_onesignal_config_secure(p_app_id text, p_rest_api_key text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
BEGIN
    INSERT INTO public.onesignal_config (id, onesignal_app_id, onesignal_rest_api_key, updated_at)
    VALUES (1, btrim(COALESCE(p_app_id, '')), btrim(COALESCE(p_rest_api_key, '')), now())
    ON CONFLICT (id) DO UPDATE
    SET onesignal_app_id = EXCLUDED.onesignal_app_id,
        onesignal_rest_api_key = CASE
            WHEN EXCLUDED.onesignal_rest_api_key <> '' THEN EXCLUDED.onesignal_rest_api_key
            ELSE public.onesignal_config.onesignal_rest_api_key
        END,
        updated_at = now();

    RETURN jsonb_build_object('success', true);
END;
$function$
;

CREATE OR REPLACE FUNCTION public.fn_guard_devices_direct_tamper()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
    IF current_user IN ('anon', 'authenticated') THEN
        IF TG_OP = 'INSERT' THEN
            NEW.status := 'pending';
            NEW.is_banned := false;
            NEW.is_blocked := false;
            NEW.can_view_profiles := false;
        ELSIF TG_OP = 'UPDATE' THEN
            NEW.is_banned := OLD.is_banned;
            NEW.is_blocked := OLD.is_blocked;
            NEW.ban_reason := OLD.ban_reason;
            NEW.rejection_reason := OLD.rejection_reason;
            NEW.can_view_profiles := OLD.can_view_profiles;
            NEW.is_access_restricted := OLD.is_access_restricted;
            NEW.allowed_classes := OLD.allowed_classes;
            NEW.allowed_groups := OLD.allowed_groups;
            NEW.allowed_batches := OLD.allowed_batches;
            NEW.allowed_programs := OLD.allowed_programs;
            IF LOWER(COALESCE(NEW.status, '')) IN ('active', 'approved') AND LOWER(COALESCE(OLD.status, '')) NOT IN ('active', 'approved') THEN
                NEW.status := OLD.status;
            END IF;
        END IF;
    END IF;
    RETURN NEW;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.fn_guard_enrollments_direct_tamper()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
    IF current_user IN ('anon', 'authenticated') THEN
        IF TG_OP = 'INSERT' THEN
            NEW.status := 'REQUESTED';
            NEW.access_status := 'REQUESTED';
            NEW.paid_amount := 0;
            NEW.approved_at := NULL;
            NEW.unlocked_at := NULL;
        ELSIF TG_OP = 'UPDATE' THEN
            NEW.paid_amount := OLD.paid_amount;
            NEW.total_price := OLD.total_price;
            NEW.total_fee := OLD.total_fee;
            NEW.approved_at := OLD.approved_at;
            NEW.unlocked_at := OLD.unlocked_at;
            NEW.trial_days := OLD.trial_days;
            NEW.trial_hours := OLD.trial_hours;
            IF UPPER(COALESCE(NEW.status, '')) = 'ACTIVE' AND UPPER(COALESCE(OLD.status, '')) <> 'ACTIVE' THEN
                NEW.status := OLD.status;
                NEW.access_status := OLD.access_status;
            END IF;
        END IF;
    END IF;
    RETURN NEW;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.fn_guard_payment_tx_direct_tamper()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
    IF current_user IN ('anon', 'authenticated') THEN
        NEW.status := 'PENDING';
        NEW.reviewed_at := NULL;
    END IF;
    RETURN NEW;
END;
$function$
;

