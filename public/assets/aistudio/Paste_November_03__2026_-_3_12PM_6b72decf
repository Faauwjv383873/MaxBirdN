CREATE OR REPLACE FUNCTION public.normalize_bd_phone(p_raw text)
 RETURNS text
 LANGUAGE plpgsql
 IMMUTABLE
AS $function$
DECLARE
  v_digits text;
BEGIN
  IF p_raw IS NULL OR btrim(p_raw) = '' THEN
    RETURN '';
  END IF;
  v_digits := regexp_replace(p_raw, '[^0-9]', '', 'g');
  IF length(v_digits) = 13 AND left(v_digits, 4) = '8801' THEN
    RETURN substring(v_digits FROM 3);
  ELSIF length(v_digits) = 14 AND left(v_digits, 6) = '008801' THEN
    RETURN substring(v_digits FROM 5);
  ELSIF length(v_digits) = 11 AND left(v_digits, 2) = '01' THEN
    RETURN v_digits;
  ELSIF length(v_digits) = 10 AND left(v_digits, 1) = '1' THEN
    RETURN '0' || v_digits;
  ELSIF length(v_digits) > 11 AND left(right(v_digits, 11), 2) = '01' THEN
    RETURN right(v_digits, 11);
  END IF;
  RETURN btrim(p_raw);
END;
$function$
;

CREATE OR REPLACE FUNCTION public.admin_toggle_device_ban(p_device_hash text, p_is_banned boolean, p_reason text DEFAULT 'অ্যাডমিন কর্তৃক এই ডিভাইসের অ্যাক্সেস স্থগিত করা হয়েছে।'::text)
 RETURNS json
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
    UPDATE public.devices
    SET is_banned = p_is_banned,
        is_blocked = p_is_banned,
        status = CASE WHEN p_is_banned THEN 'blocked' ELSE 'active' END,
        ban_reason = CASE WHEN p_is_banned THEN p_reason ELSE '' END,
        rejection_reason = CASE WHEN p_is_banned THEN p_reason ELSE '' END,
        banned_at = CASE WHEN p_is_banned THEN now() ELSE NULL END,
        updated_at = now()
    WHERE device_hash = p_device_hash OR device_id = p_device_hash;

    RETURN json_build_object('success', true, 'device_hash', p_device_hash, 'is_banned', p_is_banned);
END;
$function$
;

CREATE OR REPLACE FUNCTION public.admin_set_account_course_permissions(p_device_hash text, p_shikho_user_id text, p_user_phone text DEFAULT ''::text, p_is_access_granted boolean DEFAULT true, p_is_restricted boolean DEFAULT true, p_allowed_classes text[] DEFAULT '{}'::text[], p_allowed_groups text[] DEFAULT '{}'::text[], p_allowed_batches text[] DEFAULT '{}'::text[], p_allowed_programs text[] DEFAULT '{}'::text[], p_revoke_other_accounts boolean DEFAULT true)
 RETURNS json
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
BEGIN
    IF p_revoke_other_accounts = true AND p_is_access_granted = true THEN
        UPDATE public.device_shikho_accounts
        SET is_access_granted = false,
            is_access_restricted = false,
            allowed_classes = '{}'::TEXT[],
            allowed_groups = '{}'::TEXT[],
            allowed_batches = '{}'::TEXT[],
            allowed_programs = '{}'::TEXT[]
        WHERE (device_hash = p_device_hash OR display_device_id = p_device_hash)
          AND shikho_user_id <> p_shikho_user_id;
    END IF;

    INSERT INTO public.device_shikho_accounts (
        device_hash, display_device_id, shikho_user_id, user_phone,
        is_access_granted, is_access_restricted,
        allowed_classes, allowed_groups, allowed_batches, allowed_programs, last_seen_at
    ) VALUES (
        p_device_hash, p_device_hash, p_shikho_user_id, COALESCE(p_user_phone, ''),
        COALESCE(p_is_access_granted, true), COALESCE(p_is_restricted, true),
        COALESCE(p_allowed_classes, '{}'::TEXT[]), COALESCE(p_allowed_groups, '{}'::TEXT[]),
        COALESCE(p_allowed_batches, '{}'::TEXT[]), COALESCE(p_allowed_programs, '{}'::TEXT[]), now()
    )
    ON CONFLICT (device_hash, shikho_user_id) DO UPDATE SET
        user_phone = COALESCE(NULLIF(EXCLUDED.user_phone, ''), public.device_shikho_accounts.user_phone),
        is_access_granted = EXCLUDED.is_access_granted,
        is_access_restricted = EXCLUDED.is_access_restricted,
        allowed_classes = EXCLUDED.allowed_classes,
        allowed_groups = EXCLUDED.allowed_groups,
        allowed_batches = EXCLUDED.allowed_batches,
        allowed_programs = EXCLUDED.allowed_programs,
        last_seen_at = now();

    IF p_is_access_granted = true THEN
        UPDATE public.devices
        SET is_access_restricted = COALESCE(p_is_restricted, true),
            bound_shikho_user_id = p_shikho_user_id,
            bound_user_phone = COALESCE(p_user_phone, ''),
            allowed_classes = COALESCE(p_allowed_classes, '{}'::TEXT[]),
            allowed_groups = COALESCE(p_allowed_groups, '{}'::TEXT[]),
            allowed_batches = COALESCE(p_allowed_batches, '{}'::TEXT[]),
            allowed_programs = COALESCE(p_allowed_programs, '{}'::TEXT[]),
            updated_at = now()
        WHERE device_hash = p_device_hash OR device_id = p_device_hash OR display_device_id = p_device_hash;
    END IF;

    RETURN json_build_object(
        'success', true,
        'message', 'নির্দিষ্ট শিখো অ্যাকাউন্টের জন্য সিলেবাস ও কোর্স এক্সেস সফলভাবে সেট করা হয়েছে!'
    );
END;
$function$
;

