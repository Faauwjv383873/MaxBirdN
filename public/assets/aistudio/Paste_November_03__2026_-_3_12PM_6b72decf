CREATE OR REPLACE FUNCTION public.admin_review_course_payment(p_transaction_id bigint, p_approve boolean, p_rejection_reason text DEFAULT ''::text, p_custom_next_due_days integer DEFAULT NULL::integer)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_tx RECORD;
    v_enr RECORD;
    v_new_paid INTEGER;
    v_new_due INTEGER;
    v_new_completed INTEGER;
    v_total_inst INTEGER;
    v_interval_days INTEGER;
    v_next_due TIMESTAMPTZ;
    v_next_amount INTEGER;
BEGIN
    SELECT * INTO v_tx FROM public.course_payment_transactions WHERE id = p_transaction_id;
    IF v_tx IS NULL THEN
        RETURN jsonb_build_object('success', FALSE, 'message', 'Transaction not found');
    END IF;

    -- যদি আগে থেকেই APPROVED হয়ে থাকে তবে ডাবল যোগ রোধ করা
    IF p_approve AND v_tx.status = 'APPROVED' THEN
        RETURN jsonb_build_object('success', TRUE, 'message', 'Already approved');
    END IF;

    SELECT * INTO v_enr FROM public.course_access_enrollments WHERE id = v_tx.enrollment_id;

    IF p_approve THEN
        IF v_enr IS NOT NULL THEN
            v_new_paid := COALESCE(v_enr.paid_amount, 0) + COALESCE(v_tx.amount, 0);
            v_new_due := GREATEST(COALESCE(v_enr.total_price, 0) - v_new_paid, 0);
            v_new_completed := COALESCE(v_enr.completed_installments, 0) + 1;
            v_total_inst := GREATEST(COALESCE(v_enr.total_installments, v_tx.total_installments, 1), 1);
            v_interval_days := COALESCE(p_custom_next_due_days, NULLIF(v_enr.installment_interval_days, 0), 7);

            IF v_new_due > 0 THEN
                v_next_due := NOW() + (v_interval_days || ' days')::INTERVAL;
                IF (v_total_inst - v_new_completed) > 0 THEN
                    v_next_amount := CEIL(v_new_due::NUMERIC / (v_total_inst - v_new_completed)::NUMERIC)::INTEGER;
                ELSE
                    v_next_amount := v_new_due;
                END IF;
            ELSE
                v_next_due := NULL;
                v_next_amount := 0;
            END IF;

            UPDATE public.course_access_enrollments
            SET
                status = 'ACTIVE',
                paid_amount = v_new_paid,
                due_amount = v_new_due,
                completed_installments = v_new_completed,
                next_installment_amount = v_next_amount,
                next_due_date = v_next_due,
                pending_installment_tx_id = '',
                pending_installment_amount = 0,
                rejection_reason = '',
                unlocked_at = COALESCE(unlocked_at, NOW()),
                updated_at = NOW()
            WHERE id = v_enr.id;
        END IF;

        UPDATE public.course_payment_transactions
        SET status = 'APPROVED', rejection_reason = '', reviewed_at = NOW()
        WHERE id = p_transaction_id;
    ELSE
        UPDATE public.course_payment_transactions
        SET
            status = 'REJECTED',
            rejection_reason = COALESCE(NULLIF(TRIM(p_rejection_reason), ''), 'পেমেন্ট তথ্য সঠিক নয়। অনুগ্রহ করে সঠিক TrxID ও মোবাইল নম্বর দিয়ে আবার চেষ্টা করুন।'),
            reviewed_at = NOW()
        WHERE id = p_transaction_id;

        IF v_enr IS NOT NULL THEN
            UPDATE public.course_access_enrollments
            SET
                status = CASE
                    WHEN v_enr.paid_amount > 0 AND (v_enr.next_due_date IS NULL OR v_enr.next_due_date > NOW()) THEN 'ACTIVE'
                    WHEN v_enr.paid_amount > 0 AND v_enr.next_due_date <= NOW() THEN 'OVERDUE'
                    ELSE 'PAYMENT_REJECTED'
                END,
                pending_installment_tx_id = '',
                pending_installment_amount = 0,
                rejection_reason = COALESCE(NULLIF(TRIM(p_rejection_reason), ''), 'পেমেন্ট তথ্য সঠিক নয়। অনুগ্রহ করে সঠিক TrxID ও মোবাইল নম্বর দিয়ে আবার চেষ্টা করুন।'),
                updated_at = NOW()
            WHERE id = v_enr.id;
        END IF;
    END IF;

    RETURN jsonb_build_object('success', TRUE);
END;
$function$
;

CREATE OR REPLACE FUNCTION public.trg_fn_devices_onesignal_notify()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_dev_id TEXT;
    v_name TEXT;
    v_phone TEXT;
    v_reason TEXT;
    v_now_blocked BOOLEAN;
    v_old_blocked BOOLEAN;
BEGIN
    BEGIN
        v_dev_id := COALESCE(NULLIF(NEW.device_hash, ''), NULLIF(NEW.device_id, ''), NEW.display_device_id, 'UNKNOWN');
        v_name := COALESCE(NULLIF(NEW.student_note, ''), NULLIF(NEW.student_name, ''), 'শিক্ষার্থী');
        v_phone := COALESCE(NULLIF(NEW.student_phone, ''), 'N/A');
        v_reason := COALESCE(NULLIF(NEW.ban_reason, ''), NULLIF(NEW.rejection_reason, ''), 'অ্যাডমিন কর্তৃক ব্লক করা হয়েছে');
        v_now_blocked := COALESCE(NEW.is_banned, false) OR COALESCE(NEW.is_blocked, false) OR LOWER(COALESCE(NEW.status, '')) IN ('blocked', 'banned', 'rejected');

        IF (TG_OP = 'INSERT' AND LOWER(COALESCE(NEW.status, 'pending')) = 'pending')
           OR (TG_OP = 'UPDATE' AND LOWER(COALESCE(NEW.status, '')) = 'pending' AND (LOWER(COALESCE(OLD.status, '')) <> 'pending' OR OLD.requested_at IS DISTINCT FROM NEW.requested_at)) THEN
            PERFORM public.notify_admin_via_onesignal(
                '📱 নতুন ডিভাইস ভেরিফিকেশন রিকোয়েস্ট!',
                v_name || ' (' || COALESCE(NEW.device_model, 'Device') || ') অ্যাপ অ্যাক্সেসের জন্য রিকোয়েস্ট পাঠিয়েছে।',
                'ADMIN_DEVICE_ACCESS_REQUEST',
                jsonb_build_object('device_id', v_dev_id, 'student_phone', v_phone)
            );
            RETURN NEW;
        END IF;

        IF TG_OP = 'UPDATE' THEN
            v_old_blocked := COALESCE(OLD.is_banned, false) OR COALESCE(OLD.is_blocked, false) OR LOWER(COALESCE(OLD.status, '')) IN ('blocked', 'banned', 'rejected');

            IF LOWER(COALESCE(OLD.status, '')) IS DISTINCT FROM LOWER(COALESCE(NEW.status, ''))
               AND LOWER(COALESCE(NEW.status, '')) IN ('active', 'approved')
               AND NOT v_now_blocked THEN
                PERFORM public.notify_student_via_onesignal(
                    NEW.onesignal_player_id, v_dev_id, NEW.student_phone,
                    '✅ ডিভাইস ভেরিফিকেশন সফল!',
                    'অভিনন্দন! অ্যাডমিন আপনার ডিভাইসের অ্যাক্সেস অনুমোদন করেছেন।',
                    'DEVICE_APPROVED',
                    jsonb_build_object('status', 'active', 'device_id', v_dev_id)
                );
            END IF;

            IF (NOT v_old_blocked) AND v_now_blocked THEN
                PERFORM public.notify_student_via_onesignal(
                    NEW.onesignal_player_id, v_dev_id, NEW.student_phone,
                    '🚫 ডিভাইস ব্লক করা হয়েছে!',
                    'আপনার ডিভাইসটি অ্যাডমিন ব্লক করেছেন। কারণ: ' || v_reason,
                    'DEVICE_BLOCKED',
                    jsonb_build_object('status', 'blocked', 'device_id', v_dev_id)
                );
            ELSIF v_old_blocked AND (NOT v_now_blocked) THEN
                PERFORM public.notify_student_via_onesignal(
                    NEW.onesignal_player_id, v_dev_id, NEW.student_phone,
                    '🔓 ডিভাইস আনব্লক করা হয়েছে!',
                    'আপনার ডিভাইসের ব্লক তুলে নেওয়া হয়েছে। এখন আবার অ্যাপ ব্যবহার করতে পারবেন।',
                    'DEVICE_UNBLOCKED',
                    jsonb_build_object('status', 'active', 'device_id', v_dev_id)
                );
            END IF;
        END IF;
    EXCEPTION WHEN OTHERS THEN
        RAISE WARNING 'trg_fn_devices_onesignal_notify skipped error: %', SQLERRM;
    END;
    RETURN NEW;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.start_course_free_trial(p_student_key text, p_program_id text, p_program_title text DEFAULT ''::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_row public.course_access_enrollments%ROWTYPE;
    v_total_hours INTEGER;
    v_now TIMESTAMPTZ := now();
    v_ends_at TIMESTAMPTZ;
    v_norm_key TEXT;
BEGIN
    v_norm_key := public.normalize_bd_phone(p_student_key);

    SELECT *
    INTO v_row
    FROM public.course_access_enrollments
    WHERE (
        shikho_account_key = p_student_key
        OR student_key = p_student_key
        OR device_id = p_student_key
        OR device_hash = p_student_key
        OR (v_norm_key <> '' AND public.normalize_bd_phone(student_phone) = v_norm_key)
    )
    AND program_id = p_program_id
    ORDER BY updated_at DESC
    LIMIT 1;

    IF NOT FOUND THEN
        RETURN jsonb_build_object('success', false, 'message', 'কোর্স এক্সেস রেকর্ড পাওয়া যায়নি।');
    END IF;

    IF COALESCE(v_row.trial_enabled, false) = false THEN
        RETURN jsonb_build_object('success', false, 'message', 'এই কোর্সের জন্য ফ্রি ট্রায়াল অনুমোদিত নয়।');
    END IF;

    IF COALESCE(v_row.is_trial_used, false) = true AND v_row.trial_ends_at IS NOT NULL AND v_row.trial_ends_at <= v_now THEN
        RETURN jsonb_build_object('success', false, 'message', 'আপনি ইতোমধ্যে এই কোর্সের ফ্রি ট্রায়াল ব্যবহার করেছেন।');
    END IF;

    IF v_row.trial_ends_at IS NOT NULL AND v_row.trial_ends_at > v_now THEN
        RETURN jsonb_build_object(
            'success', true,
            'status', 'TRIAL_ACTIVE',
            'trial_started_at', v_row.trial_started_at,
            'trial_ends_at', v_row.trial_ends_at
        );
    END IF;

    v_total_hours := GREATEST(1, (COALESCE(v_row.trial_days, 0) * 24) + COALESCE(v_row.trial_hours, 0));
    v_ends_at := v_now + (v_total_hours || ' hours')::INTERVAL;

    UPDATE public.course_access_enrollments
    SET status = 'TRIAL_ACTIVE',
        trial_started_at = v_now,
        trial_ends_at = v_ends_at,
        is_trial_used = true,
        updated_at = v_now
    WHERE id = v_row.id;

    RETURN jsonb_build_object(
        'success', true,
        'status', 'TRIAL_ACTIVE',
        'trial_started_at', v_now,
        'trial_ends_at', v_ends_at
    );
END;
$function$
;

CREATE OR REPLACE FUNCTION public.admin_manage_course_trial(p_student_key text, p_program_id text, p_action text, p_days integer DEFAULT 0, p_hours integer DEFAULT 0)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_row public.course_access_enrollments%ROWTYPE;
    v_now TIMESTAMPTZ := now();
    v_delta_hours INTEGER;
    v_new_ends_at TIMESTAMPTZ;
    v_new_status TEXT;
    v_norm_key TEXT;
BEGIN
    v_norm_key := public.normalize_bd_phone(p_student_key);

    SELECT *
    INTO v_row
    FROM public.course_access_enrollments
    WHERE (
        shikho_account_key = p_student_key
        OR student_key = p_student_key
        OR device_id = p_student_key
        OR id::text = p_student_key
        OR (v_norm_key <> '' AND public.normalize_bd_phone(student_phone) = v_norm_key)
    )
    AND program_id = p_program_id
    ORDER BY updated_at DESC
    LIMIT 1;

    IF NOT FOUND THEN
        RETURN jsonb_build_object('success', false, 'message', 'Enrollment row not found');
    END IF;

    v_delta_hours := (COALESCE(p_days, 0) * 24) + COALESCE(p_hours, 0);

    IF p_action = 'SET_DURATION' THEN
        v_new_ends_at := v_now + (GREATEST(1, v_delta_hours) || ' hours')::INTERVAL;
        UPDATE public.course_access_enrollments
        SET trial_enabled = true,
            trial_days = GREATEST(0, COALESCE(p_days, 0)),
            trial_hours = GREATEST(0, COALESCE(p_hours, 0)),
            trial_started_at = COALESCE(trial_started_at, v_now),
            trial_ends_at = v_new_ends_at,
            is_trial_used = true,
            status = CASE WHEN COALESCE(paid_amount, 0) > 0 THEN 'ACTIVE' ELSE 'TRIAL_ACTIVE' END,
            updated_at = v_now
        WHERE id = v_row.id;

    ELSIF p_action = 'ADD_HOURS' THEN
        v_new_ends_at := GREATEST(COALESCE(v_row.trial_ends_at, v_now), v_now) + (GREATEST(1, v_delta_hours) || ' hours')::INTERVAL;
        UPDATE public.course_access_enrollments
        SET trial_enabled = true,
            trial_started_at = COALESCE(trial_started_at, v_now),
            trial_ends_at = v_new_ends_at,
            is_trial_used = true,
            status = CASE WHEN COALESCE(paid_amount, 0) > 0 THEN 'ACTIVE' ELSE 'TRIAL_ACTIVE' END,
            updated_at = v_now
        WHERE id = v_row.id;

    ELSIF p_action = 'REDUCE_HOURS' THEN
        v_new_ends_at := COALESCE(v_row.trial_ends_at, v_now) - (GREATEST(1, v_delta_hours) || ' hours')::INTERVAL;
        v_new_status := CASE
            WHEN COALESCE(v_row.paid_amount, 0) > 0 THEN 'ACTIVE'
            WHEN v_new_ends_at <= v_now THEN 'APPROVED_TO_BUY'
            ELSE 'TRIAL_ACTIVE'
        END;
        UPDATE public.course_access_enrollments
        SET trial_ends_at = v_new_ends_at,
            status = v_new_status,
            updated_at = v_now
        WHERE id = v_row.id;

    ELSIF p_action = 'END_TRIAL_NOW' THEN
        UPDATE public.course_access_enrollments
        SET trial_ends_at = v_now - INTERVAL '1 minute',
            is_trial_used = true,
            status = CASE WHEN COALESCE(paid_amount, 0) > 0 THEN 'ACTIVE' ELSE 'APPROVED_TO_BUY' END,
            updated_at = v_now
        WHERE id = v_row.id;

    ELSIF p_action = 'RESET_TRIAL' THEN
        UPDATE public.course_access_enrollments
        SET trial_enabled = true,
            trial_days = GREATEST(0, COALESCE(p_days, trial_days, 1)),
            trial_hours = GREATEST(0, COALESCE(p_hours, trial_hours, 0)),
            trial_started_at = NULL,
            trial_ends_at = NULL,
            is_trial_used = false,
            status = CASE WHEN COALESCE(paid_amount, 0) > 0 THEN 'ACTIVE' ELSE 'APPROVED_TO_BUY' END,
            updated_at = v_now
        WHERE id = v_row.id;
    END IF;

    RETURN jsonb_build_object('success', true, 'action', p_action);
END;
$function$
;

CREATE OR REPLACE FUNCTION public.admin_approve_course_access_with_trial(p_student_key text, p_program_id text, p_total_price numeric, p_allow_installments boolean DEFAULT false, p_installment_plans jsonb DEFAULT '[]'::jsonb, p_trial_enabled boolean DEFAULT false, p_trial_days integer DEFAULT 0, p_trial_hours integer DEFAULT 0, p_start_trial_immediately boolean DEFAULT false, p_admin_note text DEFAULT ''::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_now TIMESTAMPTZ := now();
    v_total_hours INTEGER;
    v_trial_started TIMESTAMPTZ := NULL;
    v_trial_ends TIMESTAMPTZ := NULL;
    v_status TEXT := 'APPROVED_TO_BUY';
    v_norm_key TEXT;
BEGIN
    v_norm_key := public.normalize_bd_phone(p_student_key);
    v_total_hours := GREATEST(0, (COALESCE(p_trial_days, 0) * 24) + COALESCE(p_trial_hours, 0));

    IF p_trial_enabled AND p_start_trial_immediately AND v_total_hours > 0 THEN
        v_trial_started := v_now;
        v_trial_ends := v_now + (v_total_hours || ' hours')::INTERVAL;
        v_status := 'TRIAL_ACTIVE';
    END IF;

    UPDATE public.course_access_enrollments
    SET status = v_status,
        total_price = COALESCE(p_total_price, 0)::INTEGER,
        due_amount = GREATEST(0, COALESCE(p_total_price, 0)::INTEGER - COALESCE(paid_amount, 0)),
        allow_installments = COALESCE(p_allow_installments, false),
        installment_enabled = COALESCE(p_allow_installments, false),
        installment_plans_json = CASE WHEN p_installment_plans IS NOT NULL AND jsonb_typeof(p_installment_plans) = 'array' AND jsonb_array_length(p_installment_plans) > 0 THEN p_installment_plans ELSE installment_plans_json END,
        trial_enabled = COALESCE(p_trial_enabled, false),
        trial_days = GREATEST(0, COALESCE(p_trial_days, 0)),
        trial_hours = GREATEST(0, COALESCE(p_trial_hours, 0)),
        trial_started_at = CASE
            WHEN p_start_trial_immediately AND v_total_hours > 0 THEN v_trial_started
            WHEN NOT p_trial_enabled THEN NULL
            ELSE trial_started_at
        END,
        trial_ends_at = CASE
            WHEN p_start_trial_immediately AND v_total_hours > 0 THEN v_trial_ends
            WHEN NOT p_trial_enabled THEN NULL
            ELSE trial_ends_at
        END,
        is_trial_used = CASE
            WHEN p_start_trial_immediately AND v_total_hours > 0 THEN true
            WHEN p_trial_enabled THEN false
            ELSE is_trial_used
        END,
        admin_note = COALESCE(p_admin_note, admin_note),
        approved_at = COALESCE(approved_at, v_now),
        updated_at = v_now
    WHERE (
        shikho_account_key = p_student_key
        OR student_key = p_student_key
        OR device_id = p_student_key
        OR id::text = p_student_key
        OR (v_norm_key <> '' AND public.normalize_bd_phone(student_phone) = v_norm_key)
    )
    AND program_id = p_program_id;

    RETURN jsonb_build_object(
        'success', true,
        'status', v_status,
        'trial_ends_at', v_trial_ends
    );
END;
$function$
;

CREATE OR REPLACE FUNCTION public.notify_student_via_onesignal(p_onesignal_player_id text, p_device_hash text, p_student_phone text, p_title text, p_message text, p_event_type text DEFAULT 'STUDENT_UPDATE'::text, p_extra_data jsonb DEFAULT '{}'::jsonb)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_app_id TEXT;
    v_api_key TEXT;
    v_auth_header TEXT;
    v_target_player_id TEXT;
    v_payload JSONB;
BEGIN
    SELECT onesignal_app_id, onesignal_rest_api_key
    INTO v_app_id, v_api_key
    FROM public.onesignal_config
    WHERE id = 1;

    IF COALESCE(v_app_id, '') = '' OR COALESCE(v_api_key, '') = '' THEN
        RETURN jsonb_build_object('ok', false, 'reason', 'OneSignal config missing');
    END IF;

    IF v_api_key ILIKE 'os_v2_%' THEN
        v_auth_header := 'Key ' || v_api_key;
    ELSE
        v_auth_header := 'Basic ' || v_api_key;
    END IF;

    v_target_player_id := NULLIF(TRIM(COALESCE(p_onesignal_player_id, '')), '');

    IF v_target_player_id IS NULL AND COALESCE(p_device_hash, '') <> '' THEN
        SELECT NULLIF(TRIM(onesignal_player_id), '')
        INTO v_target_player_id
        FROM public.devices
        WHERE device_hash = p_device_hash
           OR device_id = p_device_hash
           OR display_device_id = p_device_hash
        LIMIT 1;
    END IF;

    IF v_target_player_id IS NOT NULL THEN
        v_payload := jsonb_build_object(
            'app_id', v_app_id,
            'include_player_ids', jsonb_build_array(v_target_player_id),
            'headings', jsonb_build_object('en', p_title, 'bn', p_title),
            'contents', jsonb_build_object('en', p_message, 'bn', p_message),
            'priority', 10,
            'data', COALESCE(p_extra_data, '{}'::jsonb) || jsonb_build_object(
                'type', p_event_type,
                'title', p_title,
                'body', p_message,
                'device_hash', COALESCE(p_device_hash, ''),
                'student_phone', COALESCE(p_student_phone, '')
            )
        );
    ELSIF COALESCE(p_device_hash, '') <> '' THEN
        v_payload := jsonb_build_object(
            'app_id', v_app_id,
            'filters', jsonb_build_array(
                jsonb_build_object('field', 'tag', 'key', 'device_hash', 'relation', '=', 'value', p_device_hash)
            ),
            'headings', jsonb_build_object('en', p_title, 'bn', p_title),
            'contents', jsonb_build_object('en', p_message, 'bn', p_message),
            'priority', 10,
            'data', COALESCE(p_extra_data, '{}'::jsonb) || jsonb_build_object(
                'type', p_event_type,
                'title', p_title,
                'body', p_message,
                'device_hash', COALESCE(p_device_hash, ''),
                'student_phone', COALESCE(p_student_phone, '')
            )
        );
    ELSE
        RETURN jsonb_build_object('ok', false, 'reason', 'No target player_id or device_hash');
    END IF;

    PERFORM net.http_post(
        url := 'https://onesignal.com/api/v1/notifications',
        headers := jsonb_build_object(
            'Content-Type', 'application/json',
            'Authorization', v_auth_header
        ),
        body := v_payload
    );

    RETURN jsonb_build_object('ok', true);
END;
$function$
;

CREATE OR REPLACE FUNCTION public.fn_sync_devices_columns()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
BEGIN
    NEW.device_hash := COALESCE(NULLIF(btrim(NEW.device_hash), ''), NULLIF(btrim(NEW.device_id), ''), NULLIF(btrim(NEW.display_device_id), ''));
    NEW.device_id := COALESCE(NULLIF(btrim(NEW.device_id), ''), NEW.device_hash);
    NEW.is_banned := COALESCE(NEW.is_banned, NEW.is_blocked, false);
    NEW.is_blocked := NEW.is_banned;
    NEW.ban_reason := COALESCE(NULLIF(NEW.ban_reason, ''), NULLIF(NEW.rejection_reason, ''), '');
    NEW.rejection_reason := NEW.ban_reason;
    RETURN NEW;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.submit_course_payment_transaction(p_device_id text, p_shikho_account_key text, p_student_name text, p_program_id text, p_program_title text, p_plan_id text, p_plan_title text, p_total_installments integer, p_installment_interval_days integer, p_payment_method text, p_sender_mobile text, p_amount integer, p_transaction_id text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_account_key text;
    v_real_dev_id text;
    v_player_id text;
    v_enr_id bigint;
    v_completed integer := 0;
    v_cur_status text := 'PAYMENT_PENDING';
BEGIN
    v_account_key := public.normalize_bd_phone(COALESCE(NULLIF(btrim(p_shikho_account_key), ''), btrim(p_device_id)));
    IF v_account_key = '' THEN
        v_account_key := COALESCE(NULLIF(btrim(p_shikho_account_key), ''), btrim(p_device_id));
    END IF;
    v_real_dev_id := COALESCE(NULLIF(btrim(p_device_id), ''), v_account_key);

    SELECT onesignal_player_id INTO v_player_id
    FROM public.devices
    WHERE device_hash = v_real_dev_id OR device_id = v_real_dev_id OR display_device_id = v_real_dev_id
    LIMIT 1;

    SELECT id, completed_installments, status
    INTO v_enr_id, v_completed, v_cur_status
    FROM public.course_access_enrollments
    WHERE (
        shikho_account_key = v_account_key
        OR public.normalize_bd_phone(student_phone) = v_account_key
        OR device_id = v_real_dev_id
        OR device_hash = v_real_dev_id
    ) AND program_id = p_program_id
    ORDER BY updated_at DESC
    LIMIT 1;

    IF v_enr_id IS NULL THEN
        INSERT INTO public.course_access_enrollments (
            device_id, device_hash, shikho_account_key, onesignal_player_id, student_name, student_phone,
            program_id, program_title, selected_plan_id, selected_plan_title,
            total_installments, installment_interval_days, status, updated_at
        ) VALUES (
            v_real_dev_id, v_real_dev_id, v_account_key, v_player_id, COALESCE(NULLIF(btrim(p_student_name), ''), 'শিক্ষার্থী'), v_account_key,
            p_program_id, p_program_title, p_plan_id, p_plan_title,
            GREATEST(COALESCE(p_total_installments, 1), 1), GREATEST(COALESCE(p_installment_interval_days, 7), 1),
            'PAYMENT_PENDING', now()
        ) RETURNING id, completed_installments, status INTO v_enr_id, v_completed, v_cur_status;
    ELSE
        UPDATE public.course_access_enrollments
        SET
            device_id = COALESCE(NULLIF(v_real_dev_id, ''), device_id),
            device_hash = COALESCE(NULLIF(v_real_dev_id, ''), device_hash),
            shikho_account_key = v_account_key,
            onesignal_player_id = COALESCE(NULLIF(v_player_id, ''), onesignal_player_id),
            selected_plan_id = COALESCE(NULLIF(p_plan_id, ''), selected_plan_id),
            selected_plan_title = COALESCE(NULLIF(p_plan_title, ''), selected_plan_title),
            total_installments = CASE WHEN completed_installments = 0 THEN GREATEST(COALESCE(p_total_installments, 1), 1) ELSE total_installments END,
            installment_interval_days = CASE WHEN completed_installments = 0 THEN GREATEST(COALESCE(p_installment_interval_days, 7), 1) ELSE installment_interval_days END,
            status = CASE WHEN status = 'ACTIVE' THEN 'ACTIVE' ELSE 'PAYMENT_PENDING' END,
            rejection_reason = '',
            updated_at = now()
        WHERE id = v_enr_id;
    END IF;

    INSERT INTO public.course_payment_transactions (
        enrollment_id, device_id, device_hash, shikho_account_key, student_name,
        program_id, program_title, plan_id, plan_title,
        installment_number, payment_method, sender_mobile,
        amount, transaction_id, status, submitted_at
    ) VALUES (
        v_enr_id, v_real_dev_id, v_real_dev_id, v_account_key, COALESCE(NULLIF(btrim(p_student_name), ''), 'শিক্ষার্থী'),
        p_program_id, p_program_title, COALESCE(p_plan_id, 'FULL'), COALESCE(p_plan_title, 'একবারে সম্পূর্ণ পেমেন্ট'),
        COALESCE(v_completed, 0) + 1, p_payment_method, p_sender_mobile,
        p_amount, p_transaction_id, 'PENDING', now()
    );

    RETURN jsonb_build_object(
        'success', true,
        'enrollment_id', v_enr_id,
        'message', 'আপনার পেমেন্ট তথ্য সফলভাবে জমা হয়েছে! অ্যাডমিন যাচাই করে এপ্রুভ করলেই কোর্সটি আনলক হয়ে যাবে।'
    );
END;
$function$
;

CREATE OR REPLACE FUNCTION public.enforce_overdue_course_installments()
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_overdue_count integer := 0;
    v_trial_count integer := 0;
BEGIN
    -- কিস্তির মেয়াদ শেষ হলে OVERDUE করা
    UPDATE public.course_access_enrollments
    SET status = 'OVERDUE',
        access_status = 'OVERDUE',
        updated_at = NOW()
    WHERE UPPER(COALESCE(status, '')) IN ('ACTIVE', 'APPROVED', 'INSTALLMENT_ACTIVE', 'PARTIAL_PAID')
      AND (COALESCE(installment_enabled, true) = true OR COALESCE(allow_installments, true) = true)
      AND COALESCE(due_amount, 0) > 0
      AND (
          (next_due_date IS NOT NULL AND next_due_date <= NOW())
          OR (next_installment_due_at IS NOT NULL AND next_installment_due_at <= NOW())
      );
    GET DIAGNOSTICS v_overdue_count = ROW_COUNT;

    -- ফ্রি ট্রায়ালের মেয়াদ শেষ হলে পেমেন্ট স্ট্যাটাসে ফেরত নেওয়া
    UPDATE public.course_access_enrollments
    SET status = CASE WHEN COALESCE(paid_amount, 0) > 0 THEN 'ACTIVE' ELSE 'APPROVED_TO_BUY' END,
        access_status = CASE WHEN COALESCE(paid_amount, 0) > 0 THEN 'ACTIVE' ELSE 'APPROVED_TO_BUY' END,
        is_trial_used = true,
        trial_used = true,
        updated_at = NOW()
    WHERE UPPER(COALESCE(status, '')) IN ('TRIAL_ACTIVE', 'FREE_TRIAL')
      AND (
          (trial_ends_at IS NOT NULL AND trial_ends_at <= NOW())
          OR (trial_expires_at IS NOT NULL AND trial_expires_at <= NOW())
      );
    GET DIAGNOSTICS v_trial_count = ROW_COUNT;

    RETURN v_overdue_count + v_trial_count;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.verify_device_heartbeat(p_device_hash text, p_token text, p_app_version text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
  v_device public.devices%ROWTYPE;
  v_req_ver TEXT;
  v_effective_ver TEXT;
BEGIN
  SELECT * INTO v_device
  FROM public.devices
  WHERE device_hash = p_device_hash OR device_id = p_device_hash
  LIMIT 1;

  IF NOT FOUND THEN
    RETURN jsonb_build_object('valid', false, 'reason', 'ডিভাইসটি খুঁজে পাওয়া যায়নি।');
  END IF;

  v_effective_ver := NULLIF(BTRIM(REGEXP_REPLACE(COALESCE(NULLIF(TRIM(p_app_version), ''), TRIM(COALESCE(v_device.app_version, ''))), '^[vV]', '')), '');
  v_req_ver := public.get_required_app_version_name();

  IF v_req_ver <> '' AND v_effective_ver IS NOT NULL AND LOWER(v_effective_ver) <> LOWER(v_req_ver) THEN
    RETURN jsonb_build_object(
      'valid', false,
      'status', 'update_required',
      'reason', 'পুরাতন ভার্সন বন্ধ করা হয়েছে। অনুগ্রহ করে নতুন ভার্সন (v' || v_req_ver || ') আপডেট করুন।'
    );
  END IF;

  IF COALESCE(v_device.is_banned, false) = true OR
     COALESCE(v_device.is_blocked, false) = true OR
     LOWER(COALESCE(v_device.status, '')) IN ('banned', 'blocked', 'rejected', 'revoked', 'disabled', 'suspended') THEN
    RETURN jsonb_build_object(
      'valid', false,
      'is_banned', true,
      'is_blocked', true,
      'status', v_device.status,
      'reason', COALESCE(NULLIF(v_device.ban_reason, ''), NULLIF(v_device.rejection_reason, ''), 'অ্যাডমিন আপনার ডিভাইসটি ব্লক করেছেন।')
    );
  END IF;

  IF LOWER(COALESCE(v_device.status, '')) IN ('pending', 'unverified') THEN
    RETURN jsonb_build_object(
      'valid', false,
      'status', v_device.status,
      'reason', 'আপনার ডিভাইসটি এখনো অনুমোদিত হয়নি।'
    );
  END IF;

  UPDATE public.devices
  SET last_seen = NOW(),
      updated_at = NOW(),
      app_version = CASE WHEN COALESCE(TRIM(p_app_version), '') <> '' THEN TRIM(p_app_version) ELSE app_version END
  WHERE id = v_device.id;

  RETURN jsonb_build_object(
    'valid', true,
    'is_banned', false,
    'is_blocked', false,
    'status', COALESCE(v_device.status, 'active'),
    'student_name', COALESCE(v_device.student_name, v_device.student_note, '')
  );
END;
$function$
;

