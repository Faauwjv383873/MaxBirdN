CREATE OR REPLACE FUNCTION public.notify_admin_via_onesignal(p_title text, p_message text, p_event_type text DEFAULT 'ADMIN_ALERT'::text, p_extra_data jsonb DEFAULT '{}'::jsonb)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_app_id TEXT;
    v_api_key TEXT;
    v_auth_header TEXT;
    v_player_ids TEXT[];
    v_payload JSONB;
BEGIN
    SELECT onesignal_app_id, onesignal_rest_api_key
    INTO v_app_id, v_api_key
    FROM public.onesignal_config
    WHERE id = 1;

    IF COALESCE(v_app_id, '') = '' OR COALESCE(v_api_key, '') = '' THEN
        RETURN jsonb_build_object('ok', false, 'reason', 'OneSignal config missing');
    END IF;

    IF v_api_key ILIKE 'os_v2_%' THEN
        v_auth_header := 'Key ' || v_api_key;
    ELSE
        v_auth_header := 'Basic ' || v_api_key;
    END IF;

    SELECT ARRAY_AGG(DISTINCT onesignal_player_id)
    INTO v_player_ids
    FROM public.admin_push_devices
    WHERE is_active = TRUE
      AND COALESCE(onesignal_player_id, '') <> '';

    IF v_player_ids IS NOT NULL AND ARRAY_LENGTH(v_player_ids, 1) > 0 THEN
        v_payload := jsonb_build_object(
            'app_id', v_app_id,
            'include_player_ids', to_jsonb(v_player_ids),
            'headings', jsonb_build_object('en', p_title, 'bn', p_title),
            'contents', jsonb_build_object('en', p_message, 'bn', p_message),
            'priority', 10,
            'data', COALESCE(p_extra_data, '{}'::jsonb) || jsonb_build_object(
                'type', p_event_type,
                'title', p_title,
                'body', p_message
            )
        );

        PERFORM net.http_post(
            url := 'https://onesignal.com/api/v1/notifications',
            headers := jsonb_build_object(
                'Content-Type', 'application/json',
                'Authorization', v_auth_header
            ),
            body := v_payload
        );
    END IF;

    v_payload := jsonb_build_object(
        'app_id', v_app_id,
        'filters', jsonb_build_array(
            jsonb_build_object('field', 'tag', 'key', 'role', 'relation', '=', 'value', 'admin')
        ),
        'headings', jsonb_build_object('en', p_title, 'bn', p_title),
        'contents', jsonb_build_object('en', p_message, 'bn', p_message),
        'priority', 10,
        'data', COALESCE(p_extra_data, '{}'::jsonb) || jsonb_build_object(
            'type', p_event_type,
            'title', p_title,
            'body', p_message
        )
    );

    PERFORM net.http_post(
        url := 'https://onesignal.com/api/v1/notifications',
        headers := jsonb_build_object(
            'Content-Type', 'application/json',
            'Authorization', v_auth_header
        ),
        body := v_payload
    );

    RETURN jsonb_build_object('ok', true);
END;
$function$
;

CREATE OR REPLACE FUNCTION public.admin_set_device_block_status(p_device_hash text, p_is_banned boolean DEFAULT true, p_reason text DEFAULT 'অ্যাডমিন কর্তৃক ব্লক করা হয়েছে'::text)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
BEGIN
    UPDATE public.devices
    SET
        status = CASE WHEN p_is_banned THEN 'blocked' ELSE 'active' END,
        is_banned = p_is_banned,
        is_blocked = p_is_banned,
        ban_reason = CASE WHEN p_is_banned THEN COALESCE(p_reason, '') ELSE '' END,
        rejection_reason = CASE WHEN p_is_banned THEN COALESCE(p_reason, '') ELSE '' END,
        banned_at = CASE WHEN p_is_banned THEN now() ELSE NULL END,
        approved_at = CASE WHEN NOT p_is_banned THEN now() ELSE approved_at END,
        updated_at = now()
    WHERE device_hash = p_device_hash
       OR device_id = p_device_hash
       OR display_device_id = p_device_hash
       OR id::text = p_device_hash;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.trg_fn_course_enrollments_onesignal_notify()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_title TEXT;
    v_id TEXT;
BEGIN
    BEGIN
        v_title := COALESCE(NULLIF(NEW.program_title, ''), NULLIF(NEW.course_title, ''), 'কোর্স');
        v_id := COALESCE(NULLIF(NEW.program_id, ''), NULLIF(NEW.course_id, ''), '');

        IF (TG_OP = 'INSERT' AND NEW.status = 'REQUESTED')
           OR (TG_OP = 'UPDATE' AND OLD.status IS DISTINCT FROM NEW.status AND NEW.status = 'REQUESTED') THEN
            PERFORM public.notify_admin_via_onesignal(
                '📚 নতুন কোর্স এক্সেস রিকোয়েস্ট!',
                COALESCE(NULLIF(NEW.student_name, ''), NEW.student_phone, 'শিক্ষার্থী') || ' - "' || v_title || '" কোর্সে এক্সেস রিকোয়েস্ট পাঠিয়েছে।',
                'ADMIN_COURSE_ACCESS_REQUEST',
                jsonb_build_object(
                    'enrollment_id', NEW.id,
                    'program_id', v_id,
                    'course_id', v_id,
                    'program_title', v_title,
                    'student_phone', NEW.student_phone
                )
            );
        END IF;

        IF TG_OP = 'UPDATE' AND COALESCE(OLD.is_trial_used, FALSE) = FALSE AND COALESCE(NEW.is_trial_used, FALSE) = TRUE THEN
            PERFORM public.notify_admin_via_onesignal(
                '🎁 ফ্রি ট্রায়াল শুরু হয়েছে!',
                COALESCE(NULLIF(NEW.student_name, ''), NEW.student_phone, 'শিক্ষার্থী') || ' - "' || v_title || '" কোর্সে ফ্রি ট্রায়াল চালু করেছে।',
                'ADMIN_FREE_TRIAL_STARTED',
                jsonb_build_object(
                    'enrollment_id', NEW.id,
                    'program_id', v_id,
                    'course_id', v_id,
                    'student_phone', NEW.student_phone
                )
            );
        END IF;

        IF TG_OP = 'UPDATE' AND OLD.status IS DISTINCT FROM NEW.status THEN
            IF NEW.status IN ('APPROVED_TO_BUY', 'APPROVED_UNPAID') THEN
                PERFORM public.notify_student_via_onesignal(
                    NEW.onesignal_player_id,
                    COALESCE(NULLIF(NEW.device_hash, ''), NEW.device_id),
                    NEW.student_phone,
                    '🎉 কোর্স রিকোয়েস্ট অনুমোদিত হয়েছে!',
                    '"' || v_title || '"-এর রিকোয়েস্ট অনুমোদিত হয়েছে (মূল্য: ৳' || COALESCE(NEW.total_price, 0)::INT || CASE WHEN COALESCE(NEW.trial_enabled, FALSE) AND COALESCE(NEW.trial_days, 0) > 0 THEN ', সাথে ' || NEW.trial_days || ' দিনের ফ্রি ট্রায়াল!' ELSE '' END || ')।',
                    'COURSE_ACCESS_APPROVED',
                    jsonb_build_object('program_id', v_id, 'course_id', v_id, 'status', NEW.status)
                );
            ELSIF NEW.status = 'ACTIVE' AND OLD.status <> 'ACTIVE' THEN
                PERFORM public.notify_student_via_onesignal(
                    NEW.onesignal_player_id,
                    COALESCE(NULLIF(NEW.device_hash, ''), NEW.device_id),
                    NEW.student_phone,
                    '✅ কোর্স আনলক হয়েছে!',
                    'আপনার "' || v_title || '" কোর্সটি আনলক করা হয়েছে। এখন ক্লাস শুরু করতে পারেন!',
                    'COURSE_UNLOCKED',
                    jsonb_build_object('program_id', v_id, 'course_id', v_id, 'status', NEW.status)
                );
            ELSIF NEW.status IN ('REJECTED', 'LOCKED', 'REVOKED') THEN
                PERFORM public.notify_student_via_onesignal(
                    NEW.onesignal_player_id,
                    COALESCE(NULLIF(NEW.device_hash, ''), NEW.device_id),
                    NEW.student_phone,
                    '❌ কোর্স রিকোয়েস্ট বাতিল বা লক হয়েছে',
                    '"' || v_title || '" কোর্সের এক্সেস স্থগিত বা বাতিল করা হয়েছে। ' || COALESCE(NEW.admin_note, ''),
                    'COURSE_ACCESS_REJECTED',
                    jsonb_build_object('program_id', v_id, 'course_id', v_id, 'status', NEW.status)
                );
            END IF;
        END IF;

        IF TG_OP = 'UPDATE'
           AND (OLD.trial_days IS DISTINCT FROM NEW.trial_days OR OLD.trial_ends_at IS DISTINCT FROM NEW.trial_ends_at)
           AND OLD.status = NEW.status THEN
            PERFORM public.notify_student_via_onesignal(
                NEW.onesignal_player_id,
                COALESCE(NULLIF(NEW.device_hash, ''), NEW.device_id),
                NEW.student_phone,
                '⏳ ফ্রি ট্রায়ালের সময় আপডেট হয়েছে!',
                '"' || v_title || '" কোর্সের ফ্রি ট্রায়ালের মেয়াদ অ্যাডমিন আপডেট করেছেন।',
                'COURSE_TRIAL_UPDATED',
                jsonb_build_object('program_id', v_id, 'course_id', v_id, 'trial_days', NEW.trial_days)
            );
        END IF;
    EXCEPTION WHEN OTHERS THEN
        RAISE WARNING 'trg_fn_course_enrollments_onesignal_notify skipped error: %', SQLERRM;
    END;

    RETURN NEW;
END;
$function$
;

