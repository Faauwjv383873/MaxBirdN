CREATE OR REPLACE FUNCTION public.admin_approve_course_access_request(p_enrollment_id bigint, p_total_price integer, p_installment_enabled boolean DEFAULT true, p_installment_plans_json jsonb DEFAULT NULL::jsonb, p_admin_note text DEFAULT ''::text, p_instant_free_unlock boolean DEFAULT false)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_price INTEGER := GREATEST(COALESCE(p_total_price, 1000), 0);
    v_plans JSONB;
BEGIN
    IF p_installment_plans_json IS NOT NULL AND jsonb_typeof(p_installment_plans_json) = 'array' AND jsonb_array_length(p_installment_plans_json) > 0 THEN
        v_plans := p_installment_plans_json;
    ELSE
        v_plans := jsonb_build_array(
            jsonb_build_object(
                'plan_id', 'FULL',
                'title_bn', 'এককালীন সম্পূর্ণ পেমেন্ট (' || v_price || ' টাকা)',
                'installment_count', 1,
                'first_payment', v_price,
                'per_installment_amount', v_price,
                'interval_days', 0,
                'schedule_amounts', jsonb_build_array(v_price)
            ),
            jsonb_build_object(
                'plan_id', 'INST_2',
                'title_bn', '২ কিস্তিতে পরিশোধ (' || (v_price / 2) || ' + ' || (v_price - (v_price / 2)) || ' টাকা)',
                'installment_count', 2,
                'first_payment', (v_price / 2),
                'per_installment_amount', (v_price - (v_price / 2)),
                'interval_days', 15,
                'schedule_amounts', jsonb_build_array((v_price / 2), (v_price - (v_price / 2)))
            ),
            jsonb_build_object(
                'plan_id', 'INST_5',
                'title_bn', '৫ কিস্তিতে পরিশোধ (প্রতি সপ্তাহে ' || (v_price / 5) || ' টাকা)',
                'installment_count', 5,
                'first_payment', (v_price / 5),
                'per_installment_amount', (v_price / 5),
                'interval_days', 7,
                'schedule_amounts', jsonb_build_array(
                    (v_price / 5),
                    (v_price / 5),
                    (v_price / 5),
                    (v_price / 5),
                    v_price - ((v_price / 5) * 4)
                )
            )
        );
    END IF;

    UPDATE public.course_access_enrollments
    SET
        status = CASE WHEN p_instant_free_unlock OR v_price = 0 THEN 'ACTIVE' ELSE 'APPROVED_TO_BUY' END,
        total_price = v_price,
        due_amount = CASE WHEN p_instant_free_unlock OR v_price = 0 THEN 0 ELSE GREATEST(v_price - paid_amount, 0) END,
        next_installment_amount = CASE WHEN p_instant_free_unlock OR v_price = 0 THEN 0 ELSE GREATEST(v_price - paid_amount, 0) END,
        installment_enabled = COALESCE(p_installment_enabled, TRUE),
        installment_plans_json = v_plans,
        admin_note = COALESCE(p_admin_note, ''),
        rejection_reason = '',
        approved_at = NOW(),
        unlocked_at = CASE WHEN p_instant_free_unlock OR v_price = 0 THEN NOW() ELSE unlocked_at END,
        updated_at = NOW()
    WHERE id = p_enrollment_id;

    RETURN jsonb_build_object('success', TRUE);
END;
$function$
;

CREATE OR REPLACE FUNCTION public.request_course_purchase_access(p_device_id text, p_shikho_account_key text, p_student_name text, p_student_phone text, p_student_class text, p_student_group text, p_program_id text, p_program_title text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_phone text;
    v_account_key text;
    v_real_dev_id text;
    v_player_id text;
    v_existing_id bigint;
    v_existing_status text;
BEGIN
    v_phone := public.normalize_bd_phone(COALESCE(NULLIF(btrim(p_student_phone), ''), btrim(p_shikho_account_key)));
    v_account_key := COALESCE(NULLIF(v_phone, ''), NULLIF(btrim(p_shikho_account_key), ''), btrim(p_device_id));
    v_real_dev_id := COALESCE(NULLIF(btrim(p_device_id), ''), v_account_key);

    SELECT onesignal_player_id INTO v_player_id
    FROM public.devices
    WHERE device_hash = v_real_dev_id OR device_id = v_real_dev_id OR display_device_id = v_real_dev_id
    LIMIT 1;

    SELECT id, status INTO v_existing_id, v_existing_status
    FROM public.course_access_enrollments
    WHERE (
        (v_account_key <> '' AND (shikho_account_key = v_account_key OR student_phone = v_account_key))
        OR (v_real_dev_id <> '' AND device_id = v_real_dev_id)
    )
    AND (program_id = p_program_id OR course_id = p_program_id)
    ORDER BY updated_at DESC NULLS LAST, id DESC
    LIMIT 1;

    IF v_existing_id IS NOT NULL THEN
        UPDATE public.course_access_enrollments
        SET device_id = COALESCE(NULLIF(v_real_dev_id, ''), device_id),
            shikho_account_key = COALESCE(NULLIF(v_account_key, ''), shikho_account_key),
            student_name = COALESCE(NULLIF(btrim(p_student_name), ''), student_name),
            student_phone = COALESCE(NULLIF(v_phone, ''), student_phone),
            student_class = COALESCE(NULLIF(btrim(p_student_class), ''), student_class),
            student_group = COALESCE(NULLIF(btrim(p_student_group), ''), student_group),
            program_title = COALESCE(NULLIF(btrim(p_program_title), ''), program_title),
            course_title = COALESCE(NULLIF(btrim(p_program_title), ''), course_title),
            onesignal_player_id = COALESCE(NULLIF(v_player_id, ''), onesignal_player_id),
            status = CASE
                WHEN v_existing_status IN ('ACTIVE', 'TRIAL_ACTIVE') THEN v_existing_status
                ELSE 'REQUESTED'
            END,
            access_status = CASE
                WHEN v_existing_status IN ('ACTIVE', 'TRIAL_ACTIVE') THEN v_existing_status
                ELSE 'REQUESTED'
            END,
            approved_at = CASE
                WHEN v_existing_status IN ('ACTIVE', 'TRIAL_ACTIVE') THEN approved_at
                ELSE NULL
            END,
            total_price = CASE
                WHEN v_existing_status IN ('ACTIVE', 'TRIAL_ACTIVE') THEN total_price
                ELSE 0
            END,
            total_fee = CASE
                WHEN v_existing_status IN ('ACTIVE', 'TRIAL_ACTIVE') THEN total_fee
                ELSE 0
            END,
            due_amount = CASE
                WHEN v_existing_status IN ('ACTIVE', 'TRIAL_ACTIVE') THEN due_amount
                ELSE 0
            END,
            installment_enabled = CASE
                WHEN v_existing_status IN ('ACTIVE', 'TRIAL_ACTIVE') THEN installment_enabled
                ELSE false
            END,
            allow_installments = CASE
                WHEN v_existing_status IN ('ACTIVE', 'TRIAL_ACTIVE') THEN allow_installments
                ELSE false
            END,
            installment_plans_json = CASE
                WHEN v_existing_status IN ('ACTIVE', 'TRIAL_ACTIVE') THEN installment_plans_json
                ELSE '[]'::jsonb
            END,
            installment_plans = CASE
                WHEN v_existing_status IN ('ACTIVE', 'TRIAL_ACTIVE') THEN installment_plans
                ELSE '[]'::jsonb
            END,
            updated_at = now()
        WHERE id = v_existing_id;
    ELSE
        INSERT INTO public.course_access_enrollments (
            device_id, shikho_account_key, student_name, student_phone,
            student_class, student_group, program_id, course_id,
            program_title, course_title, status, access_status,
            total_price, total_fee, paid_amount, due_amount, next_installment_amount,
            installment_enabled, allow_installments, installment_plans_json, installment_plans,
            onesignal_player_id, requested_at, updated_at
        ) VALUES (
            v_real_dev_id, v_account_key, COALESCE(NULLIF(btrim(p_student_name), ''), 'শিক্ষার্থী'), v_phone,
            p_student_class, p_student_group, p_program_id, p_program_id,
            p_program_title, p_program_title, 'REQUESTED', 'REQUESTED',
            0, 0, 0, 0, 0,
            false, false, '[]'::jsonb, '[]'::jsonb,
            v_player_id, now(), now()
        )
        RETURNING id, status INTO v_existing_id, v_existing_status;
    END IF;

    RETURN jsonb_build_object(
        'ok', true,
        'success', true,
        'enrollment_id', v_existing_id,
        'status', COALESCE(v_existing_status, 'REQUESTED')
    );
END;
$function$
;

CREATE OR REPLACE FUNCTION public.fn_sync_course_enrollment_columns()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
BEGIN
    NEW.device_id := COALESCE(NULLIF(btrim(NEW.device_id), ''), NULLIF(btrim(NEW.device_hash), ''), '');
    NEW.device_hash := COALESCE(NULLIF(btrim(NEW.device_hash), ''), NULLIF(btrim(NEW.device_id), ''), '');

    NEW.student_phone := public.normalize_bd_phone(COALESCE(NULLIF(btrim(NEW.student_phone), ''), NULLIF(btrim(NEW.user_phone), ''), ''));
    NEW.user_phone := COALESCE(NULLIF(btrim(NEW.user_phone), ''), NEW.student_phone);

    NEW.shikho_account_key := COALESCE(
        NULLIF(public.normalize_bd_phone(NEW.shikho_account_key), ''),
        NULLIF(btrim(NEW.shikho_account_key), ''),
        NULLIF(btrim(NEW.shikho_user_id), ''),
        NULLIF(btrim(NEW.student_key), ''),
        NULLIF(NEW.student_phone, ''),
        NEW.device_id
    );
    NEW.shikho_user_id := COALESCE(NULLIF(btrim(NEW.shikho_user_id), ''), NEW.shikho_account_key);
    NEW.student_key := COALESCE(NULLIF(btrim(NEW.student_key), ''), NEW.shikho_account_key);

    NEW.student_class := COALESCE(NULLIF(btrim(NEW.student_class), ''), NULLIF(btrim(NEW.class_code), ''), '');
    NEW.class_code := COALESCE(NULLIF(btrim(NEW.class_code), ''), NEW.student_class);
    NEW.student_group := COALESCE(NULLIF(btrim(NEW.student_group), ''), NULLIF(btrim(NEW.group_code), ''), '');
    NEW.group_code := COALESCE(NULLIF(btrim(NEW.group_code), ''), NEW.student_group);

    NEW.program_id := COALESCE(NULLIF(btrim(NEW.program_id), ''), NULLIF(btrim(NEW.course_id), ''), '');
    NEW.course_id := COALESCE(NULLIF(btrim(NEW.course_id), ''), NEW.program_id);
    NEW.program_title := COALESCE(NULLIF(btrim(NEW.program_title), ''), NULLIF(btrim(NEW.course_title), ''), '');
    NEW.course_title := COALESCE(NULLIF(btrim(NEW.course_title), ''), NEW.program_title);

    IF TG_OP = 'UPDATE' AND NEW.access_status IS DISTINCT FROM OLD.access_status AND NEW.status IS NOT DISTINCT FROM OLD.status THEN
        NEW.status := UPPER(COALESCE(NULLIF(btrim(NEW.access_status), ''), 'REQUESTED'));
    ELSE
        NEW.status := UPPER(COALESCE(NULLIF(btrim(NEW.status), ''), NULLIF(btrim(NEW.access_status), ''), 'REQUESTED'));
    END IF;
    NEW.access_status := NEW.status;

    NEW.selected_plan_id := COALESCE(NULLIF(btrim(NEW.selected_plan_id), ''), NULLIF(btrim(NEW.active_plan_id), ''), 'FULL');
    NEW.active_plan_id := COALESCE(NULLIF(btrim(NEW.active_plan_id), ''), NEW.selected_plan_id);
    NEW.selected_plan_title := COALESCE(NULLIF(btrim(NEW.selected_plan_title), ''), NULLIF(btrim(NEW.active_plan_title), ''), 'এককালীন সম্পূর্ণ পেমেন্ট');
    NEW.active_plan_title := COALESCE(NULLIF(btrim(NEW.active_plan_title), ''), NEW.selected_plan_title);

    NEW.next_installment_due_at := NEW.next_due_date;
    NEW.trial_used := COALESCE(NEW.is_trial_used, false);
    NEW.trial_days_granted := COALESCE(NEW.trial_days, 0);
    NEW.trial_expires_at := NEW.trial_ends_at;

    IF NEW.status IN ('REQUESTED', 'ACCESS_REQUESTED') AND NEW.approved_at IS NULL AND COALESCE(NEW.paid_amount, 0) = 0 THEN
        NEW.total_price := 0;
        NEW.total_fee := 0;
        NEW.paid_amount := 0;
        NEW.due_amount := 0;
        NEW.next_installment_amount := 0;
        NEW.installment_enabled := false;
        NEW.allow_installments := false;
        NEW.installment_plans_json := '[]'::jsonb;
        NEW.installment_plans := '[]'::jsonb;
    ELSE
        IF NEW.installment_enabled IS DISTINCT FROM NEW.allow_installments THEN
            IF TG_OP = 'UPDATE' AND NEW.allow_installments IS DISTINCT FROM OLD.allow_installments THEN
                NEW.installment_enabled := NEW.allow_installments;
            ELSE
                NEW.allow_installments := COALESCE(NEW.installment_enabled, true);
                NEW.installment_enabled := COALESCE(NEW.installment_enabled, true);
            END IF;
        END IF;

        IF NEW.installment_plans IS DISTINCT FROM NEW.installment_plans_json THEN
            IF TG_OP = 'UPDATE' AND NEW.installment_plans IS DISTINCT FROM OLD.installment_plans THEN
                NEW.installment_plans_json := NEW.installment_plans;
            ELSE
                NEW.installment_plans := COALESCE(NEW.installment_plans_json, '[]'::jsonb);
            END IF;
        END IF;

        NEW.total_price := COALESCE(NEW.total_price, 1000);
        NEW.total_fee := NEW.total_price;
        NEW.paid_amount := COALESCE(NEW.paid_amount, 0);
        NEW.due_amount := GREATEST(0, NEW.total_price - NEW.paid_amount);
    END IF;

    NEW.updated_at := now();
    RETURN NEW;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.admin_approve_device_verification(p_device_hash text, p_student_note text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
  v_token text;
BEGIN
  v_token := 'VERIFIED-' || gen_random_uuid()::text;

  UPDATE public.devices
  SET
    status = 'active',
    is_banned = false,
    ban_reason = '',
    session_token = COALESCE(NULLIF(btrim(session_token), ''), v_token),
    student_note = COALESCE(NULLIF(btrim(p_student_note), ''), student_note),
    applied_code = CASE
      WHEN COALESCE(btrim(applied_code), '') = '' OR applied_code LIKE 'REQ:%' THEN 'VERIFIED-STUDENT'
      ELSE applied_code
    END,
    approved_at = now(),
    updated_at = now()
  WHERE device_hash = p_device_hash OR display_device_id = p_device_hash;

  RETURN jsonb_build_object(
    'success', true,
    'status', 'active',
    'message', 'ডিভাইস ভেরিফিকেশন সফলভাবে অ্যাপ্রুভ করা হয়েছে!'
  );
END;
$function$
;

CREATE OR REPLACE FUNCTION public.request_student_verification(p_device_hash text, p_display_device_id text DEFAULT ''::text, p_device_model text DEFAULT ''::text, p_device_brand text DEFAULT ''::text, p_android_version text DEFAULT ''::text, p_app_version text DEFAULT ''::text, p_student_note text DEFAULT ''::text, p_app_signature text DEFAULT ''::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_existing record;
    v_note text := btrim(COALESCE(p_student_note, ''));
    v_req_ver text := public.get_required_app_version_name();
    v_client_ver text := NULLIF(BTRIM(REGEXP_REPLACE(COALESCE(p_app_version, ''), '^[vV]', '')), '');
BEGIN
    IF v_req_ver <> '' AND v_client_ver IS NOT NULL AND LOWER(v_client_ver) <> LOWER(v_req_ver) THEN
        RETURN jsonb_build_object(
            'success', false,
            'status', 'blocked',
            'is_banned', true,
            'ban_reason', 'পুরাতন ভার্সনের অ্যাপ (v' || v_client_ver || ') ব্যবহার করা যাবে না! শুধুমাত্র নির্ধারিত ভার্সন (v' || v_req_ver || ') ইনস্টল করুন।'
        );
    END IF;

    SELECT * INTO v_existing FROM public.devices WHERE device_hash = p_device_hash LIMIT 1;

    IF v_existing.device_hash IS NOT NULL THEN
        IF COALESCE(v_existing.is_banned, false) = true OR lower(COALESCE(v_existing.status, '')) IN ('banned', 'blocked') THEN
            RETURN jsonb_build_object(
                'success', false,
                'status', 'blocked',
                'is_banned', true,
                'ban_reason', COALESCE(NULLIF(btrim(v_existing.ban_reason), ''), 'এই ডিভাইসে অ্যাপ ব্যবহারের অনুমতি স্থগিত করা হয়েছে।')
            );
        END IF;

        IF lower(COALESCE(v_existing.status, '')) IN ('active', 'approved') THEN
            RETURN jsonb_build_object(
                'success', true,
                'status', 'active',
                'is_banned', false,
                'session_token', COALESCE(NULLIF(btrim(v_existing.session_token), ''), 'VERIFIED-' || p_device_hash)
            );
        END IF;
    END IF;

    INSERT INTO public.devices (
        device_hash, display_device_id, device_model, device_brand,
        android_version, app_version, student_note, applied_code,
        status, is_banned, requested_at, updated_at
    ) VALUES (
        p_device_hash, p_display_device_id, p_device_model, p_device_brand,
        p_android_version, p_app_version, v_note,
        CASE WHEN v_note <> '' THEN 'REQ: ' || v_note ELSE 'STUDENT-VERIFY' END,
        'pending', false, now(), now()
    )
    ON CONFLICT (device_hash) DO UPDATE SET
        display_device_id = EXCLUDED.display_device_id,
        device_model = EXCLUDED.device_model,
        device_brand = EXCLUDED.device_brand,
        android_version = EXCLUDED.android_version,
        app_version = EXCLUDED.app_version,
        student_note = CASE WHEN v_note <> '' THEN v_note ELSE public.devices.student_note END,
        applied_code = CASE WHEN v_note <> '' THEN 'REQ: ' || v_note ELSE COALESCE(NULLIF(public.devices.applied_code, ''), 'STUDENT-VERIFY') END,
        status = 'pending',
        requested_at = now(),
        updated_at = now();

    RETURN jsonb_build_object(
        'success', true,
        'status', 'pending',
        'is_banned', false,
        'student_note', v_note,
        'message', 'স্বাগতম! আপনার স্টুডেন্ট ভেরিফিকেশন আবেদন সফলভাবে গৃহীত হয়েছে।'
    );
END;
$function$
;

