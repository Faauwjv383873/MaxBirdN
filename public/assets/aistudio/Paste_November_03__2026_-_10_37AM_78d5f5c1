    "2_ALL_FUNCTIONS_AND_FULL_LOGIC": {
        "activate_device": "CREATE OR REPLACE FUNCTION public.activate_device(p_code text, p_device_hash text, p_app_signature text, p_display_device_id text, p_device_model text, p_device_brand text, p_android_version text, p_app_version text)\n RETURNS json\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_code_record RECORD;\n    v_bound_count INT;\n    v_existing_device RECORD;\n    v_device_record RECORD;\n    v_new_token TEXT := gen_random_uuid()::TEXT;\n    v_max_devices INT := 1;\nBEGIN\n    -- ডিভাইসের তথ্য সংরক্ষণ\n    INSERT INTO public.devices (\n        device_hash, display_device_id, device_model, device_brand,\n        android_version, app_version, applied_code, last_seen, updated_at\n    ) VALUES (\n        p_device_hash, COALESCE(NULLIF(p_display_device_id, ''), 'UNKNOWN'),\n        p_device_model, p_device_brand, p_android_version, p_app_version,\n        UPPER(TRIM(p_code)), now(), now()\n    )\n    ON CONFLICT (device_hash) DO UPDATE SET\n        display_device_id = CASE WHEN EXCLUDED.display_device_id <> '' AND EXCLUDED.display_device_id <> 'UNKNOWN' THEN EXCLUDED.display_device_id ELSE public.devices.display_device_id END,\n        device_model = COALESCE(NULLIF(EXCLUDED.device_model, ''), public.devices.device_model),\n        device_brand = COALESCE(NULLIF(EXCLUDED.device_brand, ''), public.devices.device_brand),\n        android_version = COALESCE(NULLIF(EXCLUDED.android_version, ''), public.devices.android_version),\n        app_version = COALESCE(NULLIF(EXCLUDED.app_version, ''), public.devices.app_version),\n        applied_code = UPPER(TRIM(p_code)), last_seen = now(), updated_at = now();\n\n    -- ডিভাইস ব্যান কিনা পরীক্ষা\n    SELECT * INTO v_device_record FROM public.devices WHERE device_hash = p_device_hash;\n    IF FOUND AND v_device_record.is_banned THEN\n        RETURN json_build_object('success', false, 'banned', true, 'is_banned', true, 'message', COALESCE(v_device_record.ban_reason, 'এই ডিভাইসটি অ্যাডমিন দ্বারা স্থায়ীভাবে ব্যান করা হয়েছে!'));\n    END IF;\n\n    -- কোড পরীক্ষা\n    SELECT * INTO v_code_record FROM public.access_codes WHERE UPPER(code) = UPPER(TRIM(p_code));\n    IF NOT FOUND THEN\n        RETURN json_build_object('success', false, 'message', 'ভুল এক্সেস কোড। সঠিক কোড দিন।');\n    END IF;\n\n    IF v_code_record.is_active IS FALSE OR (v_code_record.status IS NOT NULL AND v_code_record.status = 'inactive') THEN\n        RETURN json_build_object('success', false, 'message', 'এই এক্সেস কোডটি অ্যাডমিন দ্বারা নিষ্ক্রিয় করা হয়েছে।');\n    END IF;\n\n    IF v_code_record.expires_at IS NOT NULL AND v_code_record.expires_at < now() THEN\n        RETURN json_build_object('success', false, 'message', 'এক্সেস কোডের মেয়াদ শেষ হয়ে গেছে।');\n    END IF;\n\n    -- পূর্বে নিবন্ধিত কিনা\n    SELECT * INTO v_existing_device FROM public.activated_devices\n    WHERE code_id = v_code_record.id AND device_hash = p_device_hash;\n\n    IF FOUND THEN\n        IF v_existing_device.is_blocked THEN\n            RETURN json_build_object('success', false, 'banned', true, 'is_banned', true, 'message', 'এই ডিভাইসটি ব্লক করা হয়েছে। অ্যাডমিনের সাথে যোগাযোগ করুন।');\n        END IF;\n        UPDATE public.activated_devices SET session_token = v_new_token, last_seen = now() WHERE id = v_existing_device.id;\n        UPDATE public.devices SET status = 'active', updated_at = now() WHERE device_hash = p_device_hash;\n        RETURN json_build_object('success', true, 'token', v_new_token, 'message', 'ডিভাইস সফলভাবে পুনরায় সক্রিয় হয়েছে।');\n    END IF;\n\n    -- ডিভাইস লিমিট চেক\n    v_max_devices := COALESCE(v_code_record.max_devices, v_code_record.device_limit, 1);\n    SELECT count(*) INTO v_bound_count FROM public.activated_devices WHERE code_id = v_code_record.id;\n    IF v_bound_count >= v_max_devices THEN\n        RETURN json_build_object('success', false, 'message', 'এই কোডটি ইতিমধ্যে অন্য ফোনে ব্যবহার করা হয়েছে। ডিভাইস লিমিট শেষ।');\n    END IF;\n\n    -- নতুন ডিভাইস বাইন্ড\n    INSERT INTO public.activated_devices (code_id, device_hash, app_signature, session_token)\n    VALUES (v_code_record.id, p_device_hash, p_app_signature, v_new_token);\n\n    UPDATE public.devices SET status = 'active', updated_at = now() WHERE device_hash = p_device_hash;\n    RETURN json_build_object('success', true, 'token', v_new_token, 'message', 'ডিভাইস এক্সেস সফলভাবে সক্রিয় হয়েছে!');\nEND;\n$function$\n",
        "normalize_bd_phone": "CREATE OR REPLACE FUNCTION public.normalize_bd_phone(p_raw text)\n RETURNS text\n LANGUAGE plpgsql\n IMMUTABLE\nAS $function$\nDECLARE\n  v_digits text;\nBEGIN\n  IF p_raw IS NULL OR btrim(p_raw) = '' THEN\n    RETURN '';\n  END IF;\n  v_digits := regexp_replace(p_raw, '[^0-9]', '', 'g');\n  IF length(v_digits) = 13 AND left(v_digits, 4) = '8801' THEN\n    RETURN substring(v_digits FROM 3);\n  ELSIF length(v_digits) = 14 AND left(v_digits, 6) = '008801' THEN\n    RETURN substring(v_digits FROM 5);\n  ELSIF length(v_digits) = 11 AND left(v_digits, 2) = '01' THEN\n    RETURN v_digits;\n  ELSIF length(v_digits) = 10 AND left(v_digits, 1) = '1' THEN\n    RETURN '0' || v_digits;\n  ELSIF length(v_digits) > 11 AND left(right(v_digits, 11), 2) = '01' THEN\n    RETURN right(v_digits, 11);\n  END IF;\n  RETURN btrim(p_raw);\nEND;\n$function$\n",
        "check_device_status": "CREATE OR REPLACE FUNCTION public.check_device_status(p_device_hash text)\n RETURNS json\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nBEGIN\n    RETURN public.check_student_verification_status(p_device_hash, 'UNKNOWN', '', '', '', '')::json;\nEND;\n$function$\n",
        "sync_device_ban_status": "CREATE OR REPLACE FUNCTION public.sync_device_ban_status()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nBEGIN\n    UPDATE public.activated_devices\n    SET is_blocked = NEW.is_banned\n    WHERE device_hash = NEW.device_hash;\n    RETURN NEW;\nEND;\n$function$\n",
        "admin_toggle_device_ban": "CREATE OR REPLACE FUNCTION public.admin_toggle_device_ban(p_device_hash text, p_is_banned boolean, p_reason text DEFAULT 'অ্যাডমিন কর্তৃক ব্যান করা হয়েছে'::text)\n RETURNS json\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nBEGIN\n    UPDATE public.devices\n    SET is_banned = p_is_banned,\n        ban_reason = p_reason,\n        banned_at = CASE WHEN p_is_banned THEN now() ELSE NULL END,\n        status = CASE WHEN p_is_banned THEN 'banned' ELSE 'active' END,\n        updated_at = now()\n    WHERE device_hash = p_device_hash;\n\n    UPDATE public.activated_devices\n    SET is_blocked = p_is_banned\n    WHERE device_hash = p_device_hash;\n\n    RETURN json_build_object('success', true, 'is_banned', p_is_banned);\nEND;\n$function$\n",
        "fn_sync_devices_columns": "CREATE OR REPLACE FUNCTION public.fn_sync_devices_columns()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nBEGIN\n    NEW.device_hash := COALESCE(NULLIF(btrim(NEW.device_hash), ''), NULLIF(btrim(NEW.device_id), ''), NULLIF(btrim(NEW.display_device_id), ''));\n    NEW.device_id := COALESCE(NULLIF(btrim(NEW.device_id), ''), NEW.device_hash);\n    NEW.is_banned := COALESCE(NEW.is_banned, NEW.is_blocked, false);\n    NEW.is_blocked := NEW.is_banned;\n    NEW.ban_reason := COALESCE(NULLIF(NEW.ban_reason, ''), NULLIF(NEW.rejection_reason, ''), '');\n    NEW.rejection_reason := NEW.ban_reason;\n    RETURN NEW;\nEND;\n$function$\n",
        "start_course_free_trial": "CREATE OR REPLACE FUNCTION public.start_course_free_trial(p_student_key text, p_program_id text, p_program_title text DEFAULT ''::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_row public.course_access_enrollments%ROWTYPE;\n    v_total_hours INTEGER;\n    v_now TIMESTAMPTZ := now();\n    v_ends_at TIMESTAMPTZ;\n    v_norm_key TEXT;\nBEGIN\n    v_norm_key := public.normalize_bd_phone(p_student_key);\n\n    SELECT *\n    INTO v_row\n    FROM public.course_access_enrollments\n    WHERE (\n        shikho_account_key = p_student_key\n        OR student_key = p_student_key\n        OR device_id = p_student_key\n        OR device_hash = p_student_key\n        OR (v_norm_key <> '' AND public.normalize_bd_phone(student_phone) = v_norm_key)\n    )\n    AND program_id = p_program_id\n    ORDER BY updated_at DESC\n    LIMIT 1;\n\n    IF NOT FOUND THEN\n        RETURN jsonb_build_object('success', false, 'message', 'কোর্স এক্সেস রেকর্ড পাওয়া যায়নি।');\n    END IF;\n\n    IF COALESCE(v_row.trial_enabled, false) = false THEN\n        RETURN jsonb_build_object('success', false, 'message', 'এই কোর্সের জন্য ফ্রি ট্রায়াল অনুমোদিত নয়।');\n    END IF;\n\n    IF COALESCE(v_row.is_trial_used, false) = true AND v_row.trial_ends_at IS NOT NULL AND v_row.trial_ends_at <= v_now THEN\n        RETURN jsonb_build_object('success', false, 'message', 'আপনি ইতোমধ্যে এই কোর্সের ফ্রি ট্রায়াল ব্যবহার করেছেন।');\n    END IF;\n\n    IF v_row.trial_ends_at IS NOT NULL AND v_row.trial_ends_at > v_now THEN\n        RETURN jsonb_build_object(\n            'success', true,\n            'status', 'TRIAL_ACTIVE',\n            'trial_started_at', v_row.trial_started_at,\n            'trial_ends_at', v_row.trial_ends_at\n        );\n    END IF;\n\n    v_total_hours := GREATEST(1, (COALESCE(v_row.trial_days, 0) * 24) + COALESCE(v_row.trial_hours, 0));\n    v_ends_at := v_now + (v_total_hours || ' hours')::INTERVAL;\n\n    UPDATE public.course_access_enrollments\n    SET status = 'TRIAL_ACTIVE',\n        trial_started_at = v_now,\n        trial_ends_at = v_ends_at,\n        is_trial_used = true,\n        updated_at = v_now\n    WHERE id = v_row.id;\n\n    RETURN jsonb_build_object(\n        'success', true,\n        'status', 'TRIAL_ACTIVE',\n        'trial_started_at', v_now,\n        'trial_ends_at', v_ends_at\n    );\nEND;\n$function$\n",
        "verify_device_heartbeat": "CREATE OR REPLACE FUNCTION public.verify_device_heartbeat(p_device_hash text, p_token text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n  v_dev record;\n  v_act record;\nBEGIN\n  SELECT *\n  INTO v_dev\n  FROM public.devices\n  WHERE device_hash = p_device_hash\n  LIMIT 1;\n\n  IF v_dev.device_hash IS NOT NULL THEN\n    IF COALESCE(v_dev.is_banned, false) = true OR lower(COALESCE(v_dev.status, '')) IN ('banned', 'blocked', 'rejected', 'pending', 'unverified') THEN\n      RETURN jsonb_build_object(\n        'valid', false,\n        'reason', COALESCE(NULLIF(btrim(v_dev.ban_reason), ''), 'ডিভাইস ভেরিফিকেশন স্থগিত করা হয়েছে।')\n      );\n    END IF;\n\n    IF lower(COALESCE(v_dev.status, '')) IN ('active', 'approved') THEN\n      RETURN jsonb_build_object(\n        'valid', true,\n        'reason', 'OK'\n      );\n    END IF;\n  END IF;\n\n  SELECT *\n  INTO v_act\n  FROM public.activated_devices\n  WHERE device_hash = p_device_hash\n  LIMIT 1;\n\n  IF v_act.id IS NOT NULL AND COALESCE(v_act.is_blocked, false) = false THEN\n    RETURN jsonb_build_object('valid', true, 'reason', 'OK');\n  END IF;\n\n  RETURN jsonb_build_object('valid', false, 'reason', 'NOT_VERIFIED');\nEND;\n$function$\n",
        "admin_manage_course_trial": "CREATE OR REPLACE FUNCTION public.admin_manage_course_trial(p_student_key text, p_program_id text, p_action text, p_days integer DEFAULT 0, p_hours integer DEFAULT 0)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_row public.course_access_enrollments%ROWTYPE;\n    v_now TIMESTAMPTZ := now();\n    v_delta_hours INTEGER;\n    v_new_ends_at TIMESTAMPTZ;\n    v_new_status TEXT;\n    v_norm_key TEXT;\nBEGIN\n    v_norm_key := public.normalize_bd_phone(p_student_key);\n\n    SELECT *\n    INTO v_row\n    FROM public.course_access_enrollments\n    WHERE (\n        shikho_account_key = p_student_key\n        OR student_key = p_student_key\n        OR device_id = p_student_key\n        OR id::text = p_student_key\n        OR (v_norm_key <> '' AND public.normalize_bd_phone(student_phone) = v_norm_key)\n    )\n    AND program_id = p_program_id\n    ORDER BY updated_at DESC\n    LIMIT 1;\n\n    IF NOT FOUND THEN\n        RETURN jsonb_build_object('success', false, 'message', 'Enrollment row not found');\n    END IF;\n\n    v_delta_hours := (COALESCE(p_days, 0) * 24) + COALESCE(p_hours, 0);\n\n    IF p_action = 'SET_DURATION' THEN\n        v_new_ends_at := v_now + (GREATEST(1, v_delta_hours) || ' hours')::INTERVAL;\n        UPDATE public.course_access_enrollments\n        SET trial_enabled = true,\n            trial_days = GREATEST(0, COALESCE(p_days, 0)),\n            trial_hours = GREATEST(0, COALESCE(p_hours, 0)),\n            trial_started_at = COALESCE(trial_started_at, v_now),\n            trial_ends_at = v_new_ends_at,\n            is_trial_used = true,\n            status = CASE WHEN COALESCE(paid_amount, 0) > 0 THEN 'ACTIVE' ELSE 'TRIAL_ACTIVE' END,\n            updated_at = v_now\n        WHERE id = v_row.id;\n\n    ELSIF p_action = 'ADD_HOURS' THEN\n        v_new_ends_at := GREATEST(COALESCE(v_row.trial_ends_at, v_now), v_now) + (GREATEST(1, v_delta_hours) || ' hours')::INTERVAL;\n        UPDATE public.course_access_enrollments\n        SET trial_enabled = true,\n            trial_started_at = COALESCE(trial_started_at, v_now),\n            trial_ends_at = v_new_ends_at,\n            is_trial_used = true,\n            status = CASE WHEN COALESCE(paid_amount, 0) > 0 THEN 'ACTIVE' ELSE 'TRIAL_ACTIVE' END,\n            updated_at = v_now\n        WHERE id = v_row.id;\n\n    ELSIF p_action = 'REDUCE_HOURS' THEN\n        v_new_ends_at := COALESCE(v_row.trial_ends_at, v_now) - (GREATEST(1, v_delta_hours) || ' hours')::INTERVAL;\n        v_new_status := CASE\n            WHEN COALESCE(v_row.paid_amount, 0) > 0 THEN 'ACTIVE'\n            WHEN v_new_ends_at <= v_now THEN 'APPROVED_TO_BUY'\n            ELSE 'TRIAL_ACTIVE'\n        END;\n        UPDATE public.course_access_enrollments\n        SET trial_ends_at = v_new_ends_at,\n            status = v_new_status,\n            updated_at = v_now\n        WHERE id = v_row.id;\n\n    ELSIF p_action = 'END_TRIAL_NOW' THEN\n        UPDATE public.course_access_enrollments\n        SET trial_ends_at = v_now - INTERVAL '1 minute',\n            is_trial_used = true,\n            status = CASE WHEN COALESCE(paid_amount, 0) > 0 THEN 'ACTIVE' ELSE 'APPROVED_TO_BUY' END,\n            updated_at = v_now\n        WHERE id = v_row.id;\n\n    ELSIF p_action = 'RESET_TRIAL' THEN\n        UPDATE public.course_access_enrollments\n        SET trial_enabled = true,\n            trial_days = GREATEST(0, COALESCE(p_days, trial_days, 1)),\n            trial_hours = GREATEST(0, COALESCE(p_hours, trial_hours, 0)),\n            trial_started_at = NULL,\n            trial_ends_at = NULL,\n            is_trial_used = false,\n            status = CASE WHEN COALESCE(paid_amount, 0) > 0 THEN 'ACTIVE' ELSE 'APPROVED_TO_BUY' END,\n            updated_at = v_now\n        WHERE id = v_row.id;\n    END IF;\n\n    RETURN jsonb_build_object('success', true, 'action', p_action);\nEND;\n$function$\n",
        "notify_admin_via_onesignal": "CREATE OR REPLACE FUNCTION public.notify_admin_via_onesignal(p_title text, p_message text, p_event_type text DEFAULT 'ADMIN_ALERT'::text, p_extra_data jsonb DEFAULT '{}'::jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_app_id TEXT;\n    v_api_key TEXT;\n    v_auth_header TEXT;\n    v_player_ids TEXT[];\n    v_payload JSONB;\nBEGIN\n    SELECT onesignal_app_id, onesignal_rest_api_key\n    INTO v_app_id, v_api_key\n    FROM public.onesignal_config\n    WHERE id = 1;\n\n    IF COALESCE(v_app_id, '') = '' OR COALESCE(v_api_key, '') = '' THEN\n        RETURN jsonb_build_object('ok', false, 'reason', 'OneSignal config missing');\n    END IF;\n\n    IF v_api_key ILIKE 'os_v2_%' THEN\n        v_auth_header := 'Key ' || v_api_key;\n    ELSE\n        v_auth_header := 'Basic ' || v_api_key;\n    END IF;\n\n    SELECT ARRAY_AGG(DISTINCT onesignal_player_id)\n    INTO v_player_ids\n    FROM public.admin_push_devices\n    WHERE is_active = TRUE\n      AND COALESCE(onesignal_player_id, '') <> '';\n\n    IF v_player_ids IS NOT NULL AND ARRAY_LENGTH(v_player_ids, 1) > 0 THEN\n        v_payload := jsonb_build_object(\n            'app_id', v_app_id,\n            'include_player_ids', to_jsonb(v_player_ids),\n            'headings', jsonb_build_object('en', p_title, 'bn', p_title),\n            'contents', jsonb_build_object('en', p_message, 'bn', p_message),\n            'priority', 10,\n            'data', COALESCE(p_extra_data, '{}'::jsonb) || jsonb_build_object(\n                'type', p_event_type,\n                'title', p_title,\n                'body', p_message\n            )\n        );\n\n        PERFORM net.http_post(\n            url := 'https://onesignal.com/api/v1/notifications',\n            headers := jsonb_build_object(\n                'Content-Type', 'application/json',\n                'Authorization', v_auth_header\n            ),\n            body := v_payload\n        );\n    END IF;\n\n    v_payload := jsonb_build_object(\n        'app_id', v_app_id,\n        'filters', jsonb_build_array(\n            jsonb_build_object('field', 'tag', 'key', 'role', 'relation', '=', 'value', 'admin')\n        ),\n        'headings', jsonb_build_object('en', p_title, 'bn', p_title),\n        'contents', jsonb_build_object('en', p_message, 'bn', p_message),\n        'priority', 10,\n        'data', COALESCE(p_extra_data, '{}'::jsonb) || jsonb_build_object(\n            'type', p_event_type,\n            'title', p_title,\n            'body', p_message\n        )\n    );\n\n    PERFORM net.http_post(\n        url := 'https://onesignal.com/api/v1/notifications',\n        headers := jsonb_build_object(\n            'Content-Type', 'application/json',\n            'Authorization', v_auth_header\n        ),\n        body := v_payload\n    );\n\n    RETURN jsonb_build_object('ok', true);\nEND;\n$function$\n",
        "sync_student_push_identity": "CREATE OR REPLACE FUNCTION public.sync_student_push_identity(p_device_hash text, p_display_device_id text, p_student_phone text DEFAULT ''::text, p_student_key text DEFAULT ''::text, p_onesignal_player_id text DEFAULT ''::text, p_fcm_token text DEFAULT ''::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_norm_phone TEXT := public.normalize_bd_phone(p_student_phone);\nBEGIN\n    UPDATE public.devices\n    SET\n        onesignal_player_id = CASE WHEN COALESCE(p_onesignal_player_id, '') <> '' THEN p_onesignal_player_id ELSE onesignal_player_id END,\n        fcm_token = CASE WHEN COALESCE(p_fcm_token, '') <> '' THEN p_fcm_token ELSE fcm_token END,\n        student_phone = CASE WHEN v_norm_phone <> '' THEN v_norm_phone ELSE student_phone END,\n        updated_at = NOW()\n    WHERE device_hash = p_device_hash\n       OR device_id = p_device_hash\n       OR (COALESCE(p_display_device_id, '') <> '' AND display_device_id = p_display_device_id);\n\n    UPDATE public.course_access_enrollments\n    SET\n        onesignal_player_id = CASE WHEN COALESCE(p_onesignal_player_id, '') <> '' THEN p_onesignal_player_id ELSE onesignal_player_id END,\n        fcm_token = CASE WHEN COALESCE(p_fcm_token, '') <> '' THEN p_fcm_token ELSE fcm_token END,\n        updated_at = NOW()\n    WHERE device_hash = p_device_hash\n       OR device_id = p_device_hash\n       OR (v_norm_phone <> '' AND public.normalize_bd_phone(student_phone) = v_norm_phone)\n       OR (COALESCE(p_student_key, '') <> '' AND (student_key = p_student_key OR shikho_account_key = p_student_key));\n\n    RETURN jsonb_build_object('ok', true);\nEND;\n$function$\n",
        "admin_review_course_payment": "CREATE OR REPLACE FUNCTION public.admin_review_course_payment(p_transaction_id bigint, p_approve boolean, p_rejection_reason text DEFAULT ''::text, p_custom_next_due_days integer DEFAULT NULL::integer)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_tx RECORD;\n    v_enr RECORD;\n    v_new_paid INTEGER;\n    v_new_due INTEGER;\n    v_new_completed INTEGER;\n    v_total_inst INTEGER;\n    v_interval_days INTEGER;\n    v_next_due TIMESTAMPTZ;\n    v_next_amount INTEGER;\nBEGIN\n    SELECT * INTO v_tx FROM public.course_payment_transactions WHERE id = p_transaction_id;\n    IF v_tx IS NULL THEN\n        RETURN jsonb_build_object('success', FALSE, 'message', 'Transaction not found');\n    END IF;\n\n    -- যদি আগে থেকেই APPROVED হয়ে থাকে তবে ডাবল যোগ রোধ করা\n    IF p_approve AND v_tx.status = 'APPROVED' THEN\n        RETURN jsonb_build_object('success', TRUE, 'message', 'Already approved');\n    END IF;\n\n    SELECT * INTO v_enr FROM public.course_access_enrollments WHERE id = v_tx.enrollment_id;\n\n    IF p_approve THEN\n        IF v_enr IS NOT NULL THEN\n            v_new_paid := COALESCE(v_enr.paid_amount, 0) + COALESCE(v_tx.amount, 0);\n            v_new_due := GREATEST(COALESCE(v_enr.total_price, 0) - v_new_paid, 0);\n            v_new_completed := COALESCE(v_enr.completed_installments, 0) + 1;\n            v_total_inst := GREATEST(COALESCE(v_enr.total_installments, v_tx.total_installments, 1), 1);\n            v_interval_days := COALESCE(p_custom_next_due_days, NULLIF(v_enr.installment_interval_days, 0), 7);\n\n            IF v_new_due > 0 THEN\n                v_next_due := NOW() + (v_interval_days || ' days')::INTERVAL;\n                IF (v_total_inst - v_new_completed) > 0 THEN\n                    v_next_amount := CEIL(v_new_due::NUMERIC / (v_total_inst - v_new_completed)::NUMERIC)::INTEGER;\n                ELSE\n                    v_next_amount := v_new_due;\n                END IF;\n            ELSE\n                v_next_due := NULL;\n                v_next_amount := 0;\n            END IF;\n\n            UPDATE public.course_access_enrollments\n            SET\n                status = 'ACTIVE',\n                paid_amount = v_new_paid,\n                due_amount = v_new_due,\n                completed_installments = v_new_completed,\n                next_installment_amount = v_next_amount,\n                next_due_date = v_next_due,\n                pending_installment_tx_id = '',\n                pending_installment_amount = 0,\n                rejection_reason = '',\n                unlocked_at = COALESCE(unlocked_at, NOW()),\n                updated_at = NOW()\n            WHERE id = v_enr.id;\n        END IF;\n\n        UPDATE public.course_payment_transactions\n        SET status = 'APPROVED', rejection_reason = '', reviewed_at = NOW()\n        WHERE id = p_transaction_id;\n    ELSE\n        UPDATE public.course_payment_transactions\n        SET\n            status = 'REJECTED',\n            rejection_reason = COALESCE(NULLIF(TRIM(p_rejection_reason), ''), 'পেমেন্ট তথ্য সঠিক নয়। অনুগ্রহ করে সঠিক TrxID ও মোবাইল নম্বর দিয়ে আবার চেষ্টা করুন।'),\n            reviewed_at = NOW()\n        WHERE id = p_transaction_id;\n\n        IF v_enr IS NOT NULL THEN\n            UPDATE public.course_access_enrollments\n            SET\n                status = CASE\n                    WHEN v_enr.paid_amount > 0 AND (v_enr.next_due_date IS NULL OR v_enr.next_due_date > NOW()) THEN 'ACTIVE'\n                    WHEN v_enr.paid_amount > 0 AND v_enr.next_due_date <= NOW() THEN 'OVERDUE'\n                    ELSE 'PAYMENT_REJECTED'\n                END,\n                pending_installment_tx_id = '',\n                pending_installment_amount = 0,\n                rejection_reason = COALESCE(NULLIF(TRIM(p_rejection_reason), ''), 'পেমেন্ট তথ্য সঠিক নয়। অনুগ্রহ করে সঠিক TrxID ও মোবাইল নম্বর দিয়ে আবার চেষ্টা করুন।'),\n                updated_at = NOW()\n            WHERE id = v_enr.id;\n        END IF;\n    END IF;\n\n    RETURN jsonb_build_object('success', TRUE);\nEND;\n$function$\n",
        "get_onesignal_public_app_id": "CREATE OR REPLACE FUNCTION public.get_onesignal_public_app_id()\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_app_id TEXT;\nBEGIN\n    SELECT onesignal_app_id INTO v_app_id FROM public.onesignal_config WHERE id = 1;\n    RETURN jsonb_build_object('onesignal_app_id', COALESCE(v_app_id, ''));\nEND;\n$function$\n",
        "notify_student_via_onesignal": "CREATE OR REPLACE FUNCTION public.notify_student_via_onesignal(p_onesignal_player_id text, p_device_hash text, p_student_phone text, p_title text, p_message text, p_event_type text DEFAULT 'STUDENT_UPDATE'::text, p_extra_data jsonb DEFAULT '{}'::jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_app_id TEXT;\n    v_api_key TEXT;\n    v_auth_header TEXT;\n    v_target_player_id TEXT;\n    v_payload JSONB;\nBEGIN\n    SELECT onesignal_app_id, onesignal_rest_api_key\n    INTO v_app_id, v_api_key\n    FROM public.onesignal_config\n    WHERE id = 1;\n\n    IF COALESCE(v_app_id, '') = '' OR COALESCE(v_api_key, '') = '' THEN\n        RETURN jsonb_build_object('ok', false, 'reason', 'OneSignal config missing');\n    END IF;\n\n    IF v_api_key ILIKE 'os_v2_%' THEN\n        v_auth_header := 'Key ' || v_api_key;\n    ELSE\n        v_auth_header := 'Basic ' || v_api_key;\n    END IF;\n\n    v_target_player_id := NULLIF(TRIM(COALESCE(p_onesignal_player_id, '')), '');\n\n    IF v_target_player_id IS NULL AND COALESCE(p_device_hash, '') <> '' THEN\n        SELECT NULLIF(TRIM(onesignal_player_id), '')\n        INTO v_target_player_id\n        FROM public.devices\n        WHERE device_hash = p_device_hash\n           OR device_id = p_device_hash\n           OR display_device_id = p_device_hash\n        LIMIT 1;\n    END IF;\n\n    IF v_target_player_id IS NOT NULL THEN\n        v_payload := jsonb_build_object(\n            'app_id', v_app_id,\n            'include_player_ids', jsonb_build_array(v_target_player_id),\n            'headings', jsonb_build_object('en', p_title, 'bn', p_title),\n            'contents', jsonb_build_object('en', p_message, 'bn', p_message),\n            'priority', 10,\n            'data', COALESCE(p_extra_data, '{}'::jsonb) || jsonb_build_object(\n                'type', p_event_type,\n                'title', p_title,\n                'body', p_message,\n                'device_hash', COALESCE(p_device_hash, ''),\n                'student_phone', COALESCE(p_student_phone, '')\n            )\n        );\n    ELSIF COALESCE(p_device_hash, '') <> '' THEN\n        v_payload := jsonb_build_object(\n            'app_id', v_app_id,\n            'filters', jsonb_build_array(\n                jsonb_build_object('field', 'tag', 'key', 'device_hash', 'relation', '=', 'value', p_device_hash)\n            ),\n            'headings', jsonb_build_object('en', p_title, 'bn', p_title),\n            'contents', jsonb_build_object('en', p_message, 'bn', p_message),\n            'priority', 10,\n            'data', COALESCE(p_extra_data, '{}'::jsonb) || jsonb_build_object(\n                'type', p_event_type,\n                'title', p_title,\n                'body', p_message,\n                'device_hash', COALESCE(p_device_hash, ''),\n                'student_phone', COALESCE(p_student_phone, '')\n            )\n        );\n    ELSE\n        RETURN jsonb_build_object('ok', false, 'reason', 'No target player_id or device_hash');\n    END IF;\n\n    PERFORM net.http_post(\n        url := 'https://onesignal.com/api/v1/notifications',\n        headers := jsonb_build_object(\n            'Content-Type', 'application/json',\n            'Authorization', v_auth_header\n        ),\n        body := v_payload\n    );\n\n    RETURN jsonb_build_object('ok', true);\nEND;\n$function$\n",
        "request_student_verification": "CREATE OR REPLACE FUNCTION public.request_student_verification(p_device_hash text, p_display_device_id text DEFAULT ''::text, p_device_model text DEFAULT ''::text, p_device_brand text DEFAULT ''::text, p_android_version text DEFAULT ''::text, p_app_version text DEFAULT ''::text, p_student_note text DEFAULT ''::text, p_app_signature text DEFAULT ''::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_existing record;\n    v_note text := btrim(COALESCE(p_student_note, ''));\n    v_req_ver text := public.get_required_app_version_name();\n    v_client_ver text := NULLIF(BTRIM(REGEXP_REPLACE(COALESCE(p_app_version, ''), '^[vV]', '')), '');\nBEGIN\n    IF v_req_ver <> '' AND v_client_ver IS NOT NULL AND LOWER(v_client_ver) <> LOWER(v_req_ver) THEN\n        RETURN jsonb_build_object(\n            'success', false,\n            'status', 'blocked',\n            'is_banned', true,\n            'ban_reason', 'পুরাতন ভার্সনের অ্যাপ (v' || v_client_ver || ') ব্যবহার করা যাবে না! শুধুমাত্র নির্ধারিত ভার্সন (v' || v_req_ver || ') ইনস্টল করুন।'\n        );\n    END IF;\n\n    SELECT * INTO v_existing FROM public.devices WHERE device_hash = p_device_hash LIMIT 1;\n\n    IF v_existing.device_hash IS NOT NULL THEN\n        IF COALESCE(v_existing.is_banned, false) = true OR lower(COALESCE(v_existing.status, '')) IN ('banned', 'blocked') THEN\n            RETURN jsonb_build_object(\n                'success', false,\n                'status', 'blocked',\n                'is_banned', true,\n                'ban_reason', COALESCE(NULLIF(btrim(v_existing.ban_reason), ''), 'এই ডিভাইসে অ্যাপ ব্যবহারের অনুমতি স্থগিত করা হয়েছে।')\n            );\n        END IF;\n\n        IF lower(COALESCE(v_existing.status, '')) IN ('active', 'approved') THEN\n            RETURN jsonb_build_object(\n                'success', true,\n                'status', 'active',\n                'is_banned', false,\n                'session_token', COALESCE(NULLIF(btrim(v_existing.session_token), ''), 'VERIFIED-' || p_device_hash)\n            );\n        END IF;\n    END IF;\n\n    INSERT INTO public.devices (\n        device_hash, display_device_id, device_model, device_brand,\n        android_version, app_version, student_note, applied_code,\n        status, is_banned, requested_at, updated_at\n    ) VALUES (\n        p_device_hash, p_display_device_id, p_device_model, p_device_brand,\n        p_android_version, p_app_version, v_note,\n        CASE WHEN v_note <> '' THEN 'REQ: ' || v_note ELSE 'STUDENT-VERIFY' END,\n        'pending', false, now(), now()\n    )\n    ON CONFLICT (device_hash) DO UPDATE SET\n        display_device_id = EXCLUDED.display_device_id,\n        device_model = EXCLUDED.device_model,\n        device_brand = EXCLUDED.device_brand,\n        android_version = EXCLUDED.android_version,\n        app_version = EXCLUDED.app_version,\n        student_note = CASE WHEN v_note <> '' THEN v_note ELSE public.devices.student_note END,\n        applied_code = CASE WHEN v_note <> '' THEN 'REQ: ' || v_note ELSE COALESCE(NULLIF(public.devices.applied_code, ''), 'STUDENT-VERIFY') END,\n        status = 'pending',\n        requested_at = now(),\n        updated_at = now();\n\n    RETURN jsonb_build_object(\n        'success', true,\n        'status', 'pending',\n        'is_banned', false,\n        'student_note', v_note,\n        'message', 'স্বাগতম! আপনার স্টুডেন্ট ভেরিফিকেশন আবেদন সফলভাবে গৃহীত হয়েছে।'\n    );\nEND;\n$function$\n",
        "admin_set_device_block_status": "CREATE OR REPLACE FUNCTION public.admin_set_device_block_status(p_device_hash text, p_is_banned boolean DEFAULT true, p_reason text DEFAULT 'অ্যাডমিন কর্তৃক ব্লক করা হয়েছে'::text)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nBEGIN\n    UPDATE public.devices\n    SET\n        status = CASE WHEN p_is_banned THEN 'blocked' ELSE 'active' END,\n        is_banned = p_is_banned,\n        is_blocked = p_is_banned,\n        ban_reason = CASE WHEN p_is_banned THEN COALESCE(p_reason, '') ELSE '' END,\n        rejection_reason = CASE WHEN p_is_banned THEN COALESCE(p_reason, '') ELSE '' END,\n        banned_at = CASE WHEN p_is_banned THEN now() ELSE NULL END,\n        approved_at = CASE WHEN NOT p_is_banned THEN now() ELSE approved_at END,\n        updated_at = now()\n    WHERE device_hash = p_device_hash\n       OR device_id = p_device_hash\n       OR display_device_id = p_device_hash\n       OR id::text = p_device_hash;\nEND;\n$function$\n",
        "get_required_app_version_name": "CREATE OR REPLACE FUNCTION public.get_required_app_version_name()\n RETURNS text\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_ver TEXT;\nBEGIN\n    SELECT NULLIF(BTRIM(REGEXP_REPLACE(COALESCE(latest_version_name, ''), '^[vV]', '')), '')\n    INTO v_ver\n    FROM public.app_updates\n    WHERE is_active = true\n    ORDER BY created_at DESC\n    LIMIT 1;\n\n    RETURN COALESCE(v_ver, '');\nEND;\n$function$\n",
        "request_course_purchase_access": "CREATE OR REPLACE FUNCTION public.request_course_purchase_access(p_device_id text, p_shikho_account_key text, p_student_name text, p_student_phone text, p_student_class text, p_student_group text, p_program_id text, p_program_title text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_phone text;\n    v_account_key text;\n    v_real_dev_id text;\n    v_player_id text;\n    v_existing_id bigint;\n    v_existing_status text;\nBEGIN\n    v_phone := public.normalize_bd_phone(COALESCE(NULLIF(btrim(p_student_phone), ''), btrim(p_shikho_account_key)));\n    v_account_key := COALESCE(NULLIF(v_phone, ''), NULLIF(btrim(p_shikho_account_key), ''), btrim(p_device_id));\n    v_real_dev_id := COALESCE(NULLIF(btrim(p_device_id), ''), v_account_key);\n\n    SELECT onesignal_player_id INTO v_player_id\n    FROM public.devices\n    WHERE device_hash = v_real_dev_id OR device_id = v_real_dev_id OR display_device_id = v_real_dev_id\n    LIMIT 1;\n\n    SELECT id, status INTO v_existing_id, v_existing_status\n    FROM public.course_access_enrollments\n    WHERE (\n        shikho_account_key = v_account_key\n        OR device_hash = v_real_dev_id\n        OR (v_phone <> '' AND public.normalize_bd_phone(student_phone) = v_phone)\n    ) AND program_id = p_program_id\n    ORDER BY updated_at DESC\n    LIMIT 1;\n\n    IF v_existing_id IS NOT NULL THEN\n        UPDATE public.course_access_enrollments\n        SET\n            device_id = v_real_dev_id,\n            device_hash = v_real_dev_id,\n            shikho_account_key = v_account_key,\n            onesignal_player_id = COALESCE(NULLIF(v_player_id, ''), onesignal_player_id),\n            student_name = COALESCE(NULLIF(btrim(p_student_name), ''), student_name),\n            student_phone = COALESCE(NULLIF(v_phone, ''), student_phone),\n            student_class = COALESCE(NULLIF(btrim(p_student_class), ''), student_class),\n            student_group = COALESCE(NULLIF(btrim(p_student_group), ''), student_group),\n            program_title = COALESCE(NULLIF(btrim(p_program_title), ''), program_title),\n            status = CASE WHEN v_existing_status IN ('LOCKED', 'REVOKED', 'REJECTED') THEN 'REQUESTED' ELSE v_existing_status END,\n            requested_at = now(),\n            updated_at = now()\n        WHERE id = v_existing_id;\n    ELSE\n        INSERT INTO public.course_access_enrollments (\n            device_id, device_hash, shikho_account_key, onesignal_player_id, student_name, student_phone,\n            student_class, student_group, program_id, program_title,\n            status, requested_at, updated_at\n        ) VALUES (\n            v_real_dev_id, v_real_dev_id, v_account_key, v_player_id, COALESCE(NULLIF(btrim(p_student_name), ''), 'শিক্ষার্থী'), v_phone,\n            COALESCE(p_student_class, ''), COALESCE(p_student_group, ''), p_program_id, p_program_title,\n            'REQUESTED', now(), now()\n        );\n    END IF;\n\n    RETURN jsonb_build_object(\n        'success', true,\n        'status', 'REQUESTED',\n        'message', 'অ্যাডমিনের কাছে কোর্সে এক্সেস রিকোয়েস্ট পাঠানো হয়েছে! অ্যাডমিন দাম সেট করে এক্সেস দিলে এখানে দেখতে পাবেন।'\n    );\nEND;\n$function$\n",
        "fn_enforce_mandatory_app_update": "CREATE OR REPLACE FUNCTION public.fn_enforce_mandatory_app_update()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nBEGIN\n    NEW.is_force_update := true;\n    RETURN NEW;\nEND;\n$function$\n",
        "trg_fn_devices_onesignal_notify": "CREATE OR REPLACE FUNCTION public.trg_fn_devices_onesignal_notify()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_dev_id TEXT;\n    v_name TEXT;\n    v_phone TEXT;\n    v_reason TEXT;\n    v_now_blocked BOOLEAN;\n    v_old_blocked BOOLEAN;\nBEGIN\n    BEGIN\n        v_dev_id := COALESCE(NULLIF(NEW.device_hash, ''), NULLIF(NEW.device_id, ''), NEW.display_device_id, 'UNKNOWN');\n        v_name := COALESCE(NULLIF(NEW.student_note, ''), NULLIF(NEW.student_name, ''), 'শিক্ষার্থী');\n        v_phone := COALESCE(NULLIF(NEW.student_phone, ''), 'N/A');\n        v_reason := COALESCE(NULLIF(NEW.ban_reason, ''), NULLIF(NEW.rejection_reason, ''), 'অ্যাডমিন কর্তৃক ব্লক করা হয়েছে');\n        v_now_blocked := COALESCE(NEW.is_banned, false) OR COALESCE(NEW.is_blocked, false) OR LOWER(COALESCE(NEW.status, '')) IN ('blocked', 'banned', 'rejected');\n\n        IF TG_OP = 'INSERT' THEN\n            IF LOWER(COALESCE(NEW.status, 'pending')) = 'pending' THEN\n                PERFORM public.notify_admin_via_onesignal(\n                    '📱 নতুন ডিভাইস ভেরিফিকেশন রিকোয়েস্ট!',\n                    v_name || ' (' || COALESCE(NEW.device_model, 'Device') || ') অ্যাপ অ্যাক্সেসের জন্য রিকোয়েস্ট পাঠিয়েছে।',\n                    'ADMIN_DEVICE_ACCESS_REQUEST',\n                    jsonb_build_object('device_id', v_dev_id, 'student_phone', v_phone)\n                );\n            END IF;\n            RETURN NEW;\n        END IF;\n\n        IF TG_OP = 'UPDATE' THEN\n            v_old_blocked := COALESCE(OLD.is_banned, false) OR COALESCE(OLD.is_blocked, false) OR LOWER(COALESCE(OLD.status, '')) IN ('blocked', 'banned', 'rejected');\n\n            IF LOWER(COALESCE(OLD.status, '')) IS DISTINCT FROM LOWER(COALESCE(NEW.status, ''))\n               AND LOWER(COALESCE(NEW.status, '')) IN ('active', 'approved')\n               AND NOT v_now_blocked THEN\n                PERFORM public.notify_student_via_onesignal(\n                    NEW.onesignal_player_id, v_dev_id, NEW.student_phone,\n                    '✅ ডিভাইস ভেরিফিকেশন সফল!',\n                    'অভিনন্দন! অ্যাডমিন আপনার ডিভাইসের অ্যাক্সেস অনুমোদন করেছেন।',\n                    'DEVICE_APPROVED',\n                    jsonb_build_object('status', 'active', 'device_id', v_dev_id)\n                );\n            END IF;\n\n            IF (NOT v_old_blocked) AND v_now_blocked THEN\n                PERFORM public.notify_student_via_onesignal(\n                    NEW.onesignal_player_id, v_dev_id, NEW.student_phone,\n                    '🚫 ডিভাইস ব্লক করা হয়েছে!',\n                    'আপনার ডিভাইসটি অ্যাডমিন ব্লক করেছেন। কারণ: ' || v_reason,\n                    'DEVICE_BLOCKED',\n                    jsonb_build_object('status', 'blocked', 'device_id', v_dev_id)\n                );\n            ELSIF v_old_blocked AND (NOT v_now_blocked) THEN\n                PERFORM public.notify_student_via_onesignal(\n                    NEW.onesignal_player_id, v_dev_id, NEW.student_phone,\n                    '🔓 ডিভাইস আনব্লক করা হয়েছে!',\n                    'আপনার ডিভাইসের ব্লক তুলে নেওয়া হয়েছে। এখন আবার অ্যাপ ব্যবহার করতে পারবেন।',\n                    'DEVICE_UNBLOCKED',\n                    jsonb_build_object('status', 'active', 'device_id', v_dev_id)\n                );\n            END IF;\n        END IF;\n    EXCEPTION WHEN OTHERS THEN\n        RAISE WARNING 'trg_fn_devices_onesignal_notify skipped error: %', SQLERRM;\n    END;\n    RETURN NEW;\nEND;\n$function$\n",
        "admin_approve_device_verification": "CREATE OR REPLACE FUNCTION public.admin_approve_device_verification(p_device_hash text)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nBEGIN\n    UPDATE public.devices\n    SET\n        status = 'active',\n        is_banned = false,\n        is_blocked = false,\n        ban_reason = '',\n        rejection_reason = '',\n        approved_at = now(),\n        updated_at = now()\n    WHERE device_hash = p_device_hash\n       OR device_id = p_device_hash\n       OR display_device_id = p_device_hash\n       OR id::text = p_device_hash;\nEND;\n$function$\n",
        "check_student_verification_status": "CREATE OR REPLACE FUNCTION public.check_student_verification_status(p_device_hash text, p_display_device_id text DEFAULT ''::text, p_device_model text DEFAULT ''::text, p_device_brand text DEFAULT ''::text, p_android_version text DEFAULT ''::text, p_app_version text DEFAULT ''::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_dev RECORD;\n    v_req_ver TEXT := public.get_required_app_version_name();\n    v_client_ver TEXT := NULLIF(BTRIM(REGEXP_REPLACE(COALESCE(p_app_version, ''), '^[vV]', '')), '');\nBEGIN\n    -- যদি ক্লায়েন্ট ভার্সন পাঠায় এবং সেটি ডাটাবেজের নির্ধারিত ভার্সনের সাথে না মেলে, সাথে সাথে ব্লক মেসেজ রিটার্ন করবে\n    IF v_req_ver <> '' AND v_client_ver IS NOT NULL AND LOWER(v_client_ver) <> LOWER(v_req_ver) THEN\n        RETURN jsonb_build_object(\n            'status', 'blocked',\n            'is_banned', true,\n            'is_blocked', true,\n            'is_approved', false,\n            'can_view_profiles', false,\n            'ban_reason', 'পুরাতন ভার্সনের অ্যাপ (v' || v_client_ver || ') ব্যবহার করা যাবে না! শুধুমাত্র নির্ধারিত ভার্সন (v' || v_req_ver || ') ইনস্টল করে ব্যবহার করুন।'\n        );\n    END IF;\n\n    SELECT * INTO v_dev\n    FROM public.devices\n    WHERE device_hash = p_device_hash\n       OR device_id = p_device_hash\n       OR (p_display_device_id <> '' AND display_device_id = p_display_device_id)\n    LIMIT 1;\n\n    IF v_dev IS NULL THEN\n        RETURN jsonb_build_object(\n            'status', 'unverified',\n            'is_banned', false,\n            'is_approved', false,\n            'can_view_profiles', false\n        );\n    END IF;\n\n    -- ক্লায়েন্টের বর্তমান ভার্সন ডাটাবেজে আপডেট রাখা\n    IF v_client_ver IS NOT NULL AND COALESCE(v_dev.app_version, '') <> v_client_ver THEN\n        UPDATE public.devices SET app_version = v_client_ver, last_seen = NOW() WHERE id = v_dev.id;\n    END IF;\n\n    IF v_dev.is_banned = true OR v_dev.is_blocked = true OR LOWER(COALESCE(v_dev.status, '')) IN ('banned', 'blocked', 'rejected', 'suspended', 'revoked') THEN\n        RETURN jsonb_build_object(\n            'status', 'banned',\n            'is_banned', true,\n            'is_approved', false,\n            'can_view_profiles', false,\n            'ban_reason', COALESCE(NULLIF(v_dev.ban_reason, ''), NULLIF(v_dev.rejection_reason, ''), 'এই ডিভাইসে প্রবেশাধিকার স্থগিত করা হয়েছে।')\n        );\n    END IF;\n\n    IF LOWER(COALESCE(v_dev.status, '')) IN ('active', 'approved') THEN\n        RETURN jsonb_build_object(\n            'status', 'active',\n            'is_banned', false,\n            'is_approved', true,\n            'session_token', COALESCE(NULLIF(v_dev.session_token, ''), 'VERIFIED-' || p_device_hash),\n            'applied_code', COALESCE(v_dev.applied_code, 'VERIFIED-DEVICE'),\n            'student_note', COALESCE(v_dev.student_note, v_dev.student_name, ''),\n            'can_view_profiles', COALESCE(v_dev.can_view_profiles, false),\n            'is_access_restricted', COALESCE(v_dev.is_access_restricted, false),\n            'allowed_classes', COALESCE(v_dev.allowed_classes, '{}'::text[]),\n            'allowed_groups', COALESCE(v_dev.allowed_groups, '{}'::text[]),\n            'allowed_batches', COALESCE(v_dev.allowed_batches, '{}'::text[]),\n            'allowed_programs', COALESCE(v_dev.allowed_programs, '{}'::text[]),\n            'bound_shikho_user_id', COALESCE(v_dev.bound_shikho_user_id, ''),\n            'bound_user_phone', COALESCE(v_dev.bound_user_phone, '')\n        );\n    END IF;\n\n    RETURN jsonb_build_object(\n        'status', COALESCE(NULLIF(v_dev.status, ''), 'pending'),\n        'is_banned', false,\n        'is_approved', false,\n        'can_view_profiles', false,\n        'student_note', COALESCE(v_dev.student_note, v_dev.student_name, '')\n    );\nEND;\n$function$\n",
        "fn_sync_course_enrollment_columns": "CREATE OR REPLACE FUNCTION public.fn_sync_course_enrollment_columns()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nBEGIN\n    -- Sync device_id <-> device_hash\n    NEW.device_id := COALESCE(NULLIF(NEW.device_id, ''), NULLIF(NEW.device_hash, ''), '');\n    NEW.device_hash := COALESCE(NULLIF(NEW.device_hash, ''), NULLIF(NEW.device_id, ''), '');\n\n    -- Sync shikho_account_key <-> shikho_user_id <-> student_key\n    NEW.shikho_account_key := COALESCE(NULLIF(NEW.shikho_account_key, ''), NULLIF(NEW.shikho_user_id, ''), NULLIF(NEW.student_key, ''), '');\n    NEW.shikho_user_id := COALESCE(NULLIF(NEW.shikho_user_id, ''), NEW.shikho_account_key);\n    NEW.student_key := COALESCE(NULLIF(NEW.student_key, ''), NEW.shikho_account_key);\n\n    -- Sync student_phone <-> user_phone\n    NEW.student_phone := COALESCE(NULLIF(NEW.student_phone, ''), NULLIF(NEW.user_phone, ''), '');\n    NEW.user_phone := COALESCE(NULLIF(NEW.user_phone, ''), NEW.student_phone);\n\n    -- Sync student_class <-> class_code & student_group <-> group_code\n    NEW.student_class := COALESCE(NULLIF(NEW.student_class, ''), NULLIF(NEW.class_code, ''), '');\n    NEW.class_code := COALESCE(NULLIF(NEW.class_code, ''), NEW.student_class);\n    NEW.student_group := COALESCE(NULLIF(NEW.student_group, ''), NULLIF(NEW.group_code, ''), '');\n    NEW.group_code := COALESCE(NULLIF(NEW.group_code, ''), NEW.student_group);\n\n    -- Sync program_id <-> course_id & program_title <-> course_title\n    NEW.program_id := COALESCE(NULLIF(NEW.program_id, ''), NULLIF(NEW.course_id, ''), '');\n    NEW.course_id := COALESCE(NULLIF(NEW.course_id, ''), NEW.program_id);\n    NEW.program_title := COALESCE(NULLIF(NEW.program_title, ''), NULLIF(NEW.course_title, ''), '');\n    NEW.course_title := COALESCE(NULLIF(NEW.course_title, ''), NEW.program_title);\n\n    -- Sync status <-> access_status\n    IF TG_OP = 'UPDATE' AND NEW.access_status IS DISTINCT FROM OLD.access_status AND NEW.status IS NOT DISTINCT FROM OLD.status THEN\n        NEW.status := NEW.access_status;\n    ELSE\n        NEW.access_status := COALESCE(NULLIF(NEW.status, ''), 'REQUESTED');\n    END IF;\n\n    -- Sync installment_enabled <-> allow_installments\n    IF NEW.installment_enabled IS DISTINCT FROM NEW.allow_installments THEN\n        IF TG_OP = 'UPDATE' AND NEW.allow_installments IS DISTINCT FROM OLD.allow_installments THEN\n            NEW.installment_enabled := NEW.allow_installments;\n        ELSE\n            NEW.allow_installments := COALESCE(NEW.installment_enabled, true);\n            NEW.installment_enabled := COALESCE(NEW.installment_enabled, true);\n        END IF;\n    END IF;\n\n    -- Sync installment_plans_json <-> installment_plans\n    IF NEW.installment_plans IS DISTINCT FROM NEW.installment_plans_json THEN\n        IF TG_OP = 'UPDATE' AND NEW.installment_plans IS DISTINCT FROM OLD.installment_plans THEN\n            NEW.installment_plans_json := NEW.installment_plans;\n        ELSE\n            NEW.installment_plans := COALESCE(NEW.installment_plans_json, '[]'::jsonb);\n        END IF;\n    END IF;\n\n    -- Sync selected_plan <-> active_plan\n    NEW.selected_plan_id := COALESCE(NULLIF(NEW.selected_plan_id, ''), NULLIF(NEW.active_plan_id, ''), 'FULL');\n    NEW.active_plan_id := COALESCE(NULLIF(NEW.active_plan_id, ''), NEW.selected_plan_id);\n    NEW.selected_plan_title := COALESCE(NULLIF(NEW.selected_plan_title, ''), NULLIF(NEW.active_plan_title, ''), 'এককালীন সম্পূর্ণ পেমেন্ট');\n    NEW.active_plan_title := COALESCE(NULLIF(NEW.active_plan_title, ''), NEW.selected_plan_title);\n\n    -- Sync trial & due dates\n    NEW.next_installment_due_at := NEW.next_due_date;\n    NEW.trial_used := COALESCE(NEW.is_trial_used, false);\n    NEW.trial_days_granted := COALESCE(NEW.trial_days, 0);\n    NEW.trial_expires_at := NEW.trial_ends_at;\n\n    -- Calculate due_amount safely\n    NEW.total_price := COALESCE(NEW.total_price, 1000);\n    NEW.total_fee := NEW.total_price;\n    NEW.paid_amount := COALESCE(NEW.paid_amount, 0);\n    NEW.due_amount := GREATEST(0, NEW.total_price - NEW.paid_amount);\n    NEW.updated_at := now();\n\n    RETURN NEW;\nEND;\n$function$\n",
        "fn_sync_course_payment_tx_columns": "CREATE OR REPLACE FUNCTION public.fn_sync_course_payment_tx_columns()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nBEGIN\n    NEW.device_id := COALESCE(NULLIF(NEW.device_id, ''), NULLIF(NEW.device_hash, ''), '');\n    NEW.device_hash := COALESCE(NULLIF(NEW.device_hash, ''), NULLIF(NEW.device_id, ''), '');\n    NEW.program_id := COALESCE(NULLIF(NEW.program_id, ''), NULLIF(NEW.course_id, ''), '');\n    NEW.course_id := COALESCE(NULLIF(NEW.course_id, ''), NEW.program_id);\n    NEW.program_title := COALESCE(NULLIF(NEW.program_title, ''), NULLIF(NEW.course_title, ''), '');\n    NEW.course_title := COALESCE(NULLIF(NEW.course_title, ''), NEW.program_title);\n    NEW.student_phone := COALESCE(NULLIF(NEW.student_phone, ''), NULLIF(NEW.user_phone, ''), NULLIF(NEW.sender_mobile, ''), '');\n    NEW.user_phone := COALESCE(NULLIF(NEW.user_phone, ''), NEW.student_phone);\n    RETURN NEW;\nEND;\n$function$\n",
        "submit_course_payment_transaction": "CREATE OR REPLACE FUNCTION public.submit_course_payment_transaction(p_device_id text, p_shikho_account_key text, p_student_name text, p_program_id text, p_program_title text, p_plan_id text, p_plan_title text, p_total_installments integer, p_installment_interval_days integer, p_payment_method text, p_sender_mobile text, p_amount integer, p_transaction_id text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_account_key text;\n    v_real_dev_id text;\n    v_player_id text;\n    v_enr_id bigint;\n    v_completed integer := 0;\n    v_cur_status text := 'PAYMENT_PENDING';\nBEGIN\n    v_account_key := public.normalize_bd_phone(COALESCE(NULLIF(btrim(p_shikho_account_key), ''), btrim(p_device_id)));\n    IF v_account_key = '' THEN\n        v_account_key := COALESCE(NULLIF(btrim(p_shikho_account_key), ''), btrim(p_device_id));\n    END IF;\n    v_real_dev_id := COALESCE(NULLIF(btrim(p_device_id), ''), v_account_key);\n\n    SELECT onesignal_player_id INTO v_player_id\n    FROM public.devices\n    WHERE device_hash = v_real_dev_id OR device_id = v_real_dev_id OR display_device_id = v_real_dev_id\n    LIMIT 1;\n\n    SELECT id, completed_installments, status\n    INTO v_enr_id, v_completed, v_cur_status\n    FROM public.course_access_enrollments\n    WHERE (\n        shikho_account_key = v_account_key\n        OR public.normalize_bd_phone(student_phone) = v_account_key\n        OR device_id = v_real_dev_id\n        OR device_hash = v_real_dev_id\n    ) AND program_id = p_program_id\n    ORDER BY updated_at DESC\n    LIMIT 1;\n\n    IF v_enr_id IS NULL THEN\n        INSERT INTO public.course_access_enrollments (\n            device_id, device_hash, shikho_account_key, onesignal_player_id, student_name, student_phone,\n            program_id, program_title, selected_plan_id, selected_plan_title,\n            total_installments, installment_interval_days, status, updated_at\n        ) VALUES (\n            v_real_dev_id, v_real_dev_id, v_account_key, v_player_id, COALESCE(NULLIF(btrim(p_student_name), ''), 'শিক্ষার্থী'), v_account_key,\n            p_program_id, p_program_title, p_plan_id, p_plan_title,\n            GREATEST(COALESCE(p_total_installments, 1), 1), GREATEST(COALESCE(p_installment_interval_days, 7), 1),\n            'PAYMENT_PENDING', now()\n        ) RETURNING id, completed_installments, status INTO v_enr_id, v_completed, v_cur_status;\n    ELSE\n        UPDATE public.course_access_enrollments\n        SET\n            device_id = COALESCE(NULLIF(v_real_dev_id, ''), device_id),\n            device_hash = COALESCE(NULLIF(v_real_dev_id, ''), device_hash),\n            shikho_account_key = v_account_key,\n            onesignal_player_id = COALESCE(NULLIF(v_player_id, ''), onesignal_player_id),\n            selected_plan_id = COALESCE(NULLIF(p_plan_id, ''), selected_plan_id),\n            selected_plan_title = COALESCE(NULLIF(p_plan_title, ''), selected_plan_title),\n            total_installments = CASE WHEN completed_installments = 0 THEN GREATEST(COALESCE(p_total_installments, 1), 1) ELSE total_installments END,\n            installment_interval_days = CASE WHEN completed_installments = 0 THEN GREATEST(COALESCE(p_installment_interval_days, 7), 1) ELSE installment_interval_days END,\n            status = CASE WHEN status = 'ACTIVE' THEN 'ACTIVE' ELSE 'PAYMENT_PENDING' END,\n            rejection_reason = '',\n            updated_at = now()\n        WHERE id = v_enr_id;\n    END IF;\n\n    INSERT INTO public.course_payment_transactions (\n        enrollment_id, device_id, device_hash, shikho_account_key, student_name,\n        program_id, program_title, plan_id, plan_title,\n        installment_number, payment_method, sender_mobile,\n        amount, transaction_id, status, submitted_at\n    ) VALUES (\n        v_enr_id, v_real_dev_id, v_real_dev_id, v_account_key, COALESCE(NULLIF(btrim(p_student_name), ''), 'শিক্ষার্থী'),\n        p_program_id, p_program_title, COALESCE(p_plan_id, 'FULL'), COALESCE(p_plan_title, 'একবারে সম্পূর্ণ পেমেন্ট'),\n        COALESCE(v_completed, 0) + 1, p_payment_method, p_sender_mobile,\n        p_amount, p_transaction_id, 'PENDING', now()\n    );\n\n    RETURN jsonb_build_object(\n        'success', true,\n        'enrollment_id', v_enr_id,\n        'message', 'আপনার পেমেন্ট তথ্য সফলভাবে জমা হয়েছে! অ্যাডমিন যাচাই করে এপ্রুভ করলেই কোর্সটি আনলক হয়ে যাবে।'\n    );\nEND;\n$function$\n",
        "get_student_course_commerce_status": "CREATE OR REPLACE FUNCTION public.get_student_course_commerce_status(p_device_id text DEFAULT ''::text, p_shikho_account_key text DEFAULT ''::text, p_shikho_user_id text DEFAULT ''::text, p_user_phone text DEFAULT ''::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_settings JSONB;\n    v_enrollments JSONB;\n    v_transactions JSONB;\n    v_clean_dev TEXT := TRIM(COALESCE(p_device_id, ''));\n    v_clean_acc TEXT := TRIM(COALESCE(p_shikho_account_key, ''));\n    v_clean_uid TEXT := TRIM(COALESCE(p_shikho_user_id, ''));\n    v_clean_phn TEXT := TRIM(COALESCE(p_user_phone, ''));\nBEGIN\n    -- মেয়াদোত্তীর্ণ ট্রায়াল অটো-আপডেট\n    UPDATE public.course_access_enrollments\n    SET status = 'TRIAL_EXPIRED', updated_at = NOW()\n    WHERE status = 'TRIAL_ACTIVE'\n      AND trial_expires_at IS NOT NULL\n      AND trial_expires_at <= NOW();\n\n    -- মেয়াদোত্তীর্ণ কিস্তি অটো-আপডেট\n    UPDATE public.course_access_enrollments\n    SET status = 'INSTALLMENT_OVERDUE', updated_at = NOW()\n    WHERE status IN ('ACTIVE', 'INSTALLMENT_ACTIVE', 'PARTIAL_PAID')\n      AND (\n          (due_amount > 0 AND next_due_date IS NOT NULL AND next_due_date <= NOW())\n          OR (installment_due_at IS NOT NULL AND installment_due_at <= NOW())\n      );\n\n    SELECT to_jsonb(s) INTO v_settings\n    FROM public.course_payment_settings s\n    WHERE s.id = 1\n    LIMIT 1;\n\n    SELECT COALESCE(jsonb_agg(to_jsonb(e) ORDER BY e.updated_at DESC), '[]'::jsonb)\n    INTO v_enrollments\n    FROM public.course_access_enrollments e\n    WHERE (v_clean_dev <> '' AND (e.device_id = v_clean_dev OR e.device_hash = v_clean_dev OR e.display_device_id = v_clean_dev))\n       OR (v_clean_acc <> '' AND (e.shikho_account_key = v_clean_acc OR e.shikho_user_id = v_clean_acc))\n       OR (v_clean_uid <> '' AND (e.shikho_user_id = v_clean_uid OR e.shikho_account_key = v_clean_uid))\n       OR (v_clean_phn <> '' AND (e.user_phone = v_clean_phn OR e.student_phone = v_clean_phn));\n\n    SELECT COALESCE(jsonb_agg(to_jsonb(t) ORDER BY t.submitted_at DESC), '[]'::jsonb)\n    INTO v_transactions\n    FROM public.course_payment_transactions t\n    WHERE (v_clean_dev <> '' AND (t.device_id = v_clean_dev OR t.device_hash = v_clean_dev OR t.display_device_id = v_clean_dev))\n       OR (v_clean_acc <> '' AND (t.shikho_account_key = v_clean_acc OR t.shikho_user_id = v_clean_acc))\n       OR (v_clean_uid <> '' AND (t.shikho_user_id = v_clean_uid OR t.shikho_account_key = v_clean_uid))\n       OR (v_clean_phn <> '' AND (t.user_phone = v_clean_phn OR t.student_phone = v_clean_phn));\n\n    RETURN jsonb_build_object(\n        'payment_settings', COALESCE(v_settings, '{}'::jsonb),\n        'enrollments', COALESCE(v_enrollments, '[]'::jsonb),\n        'transactions', COALESCE(v_transactions, '[]'::jsonb)\n    );\nEND;\n$function$\n",
        "admin_approve_course_access_request": "CREATE OR REPLACE FUNCTION public.admin_approve_course_access_request(p_enrollment_id bigint, p_total_price integer, p_installment_enabled boolean DEFAULT true, p_installment_plans_json jsonb DEFAULT NULL::jsonb, p_admin_note text DEFAULT ''::text, p_instant_free_unlock boolean DEFAULT false)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_price INTEGER := GREATEST(COALESCE(p_total_price, 1000), 0);\n    v_plans JSONB;\nBEGIN\n    IF p_installment_plans_json IS NOT NULL AND jsonb_typeof(p_installment_plans_json) = 'array' AND jsonb_array_length(p_installment_plans_json) > 0 THEN\n        v_plans := p_installment_plans_json;\n    ELSE\n        v_plans := jsonb_build_array(\n            jsonb_build_object(\n                'plan_id', 'FULL',\n                'title_bn', 'এককালীন সম্পূর্ণ পেমেন্ট (' || v_price || ' টাকা)',\n                'installment_count', 1,\n                'first_payment', v_price,\n                'per_installment_amount', v_price,\n                'interval_days', 0,\n                'schedule_amounts', jsonb_build_array(v_price)\n            ),\n            jsonb_build_object(\n                'plan_id', 'INST_2',\n                'title_bn', '২ কিস্তিতে পরিশোধ (' || (v_price / 2) || ' + ' || (v_price - (v_price / 2)) || ' টাকা)',\n                'installment_count', 2,\n                'first_payment', (v_price / 2),\n                'per_installment_amount', (v_price - (v_price / 2)),\n                'interval_days', 15,\n                'schedule_amounts', jsonb_build_array((v_price / 2), (v_price - (v_price / 2)))\n            ),\n            jsonb_build_object(\n                'plan_id', 'INST_5',\n                'title_bn', '৫ কিস্তিতে পরিশোধ (প্রতি সপ্তাহে ' || (v_price / 5) || ' টাকা)',\n                'installment_count', 5,\n                'first_payment', (v_price / 5),\n                'per_installment_amount', (v_price / 5),\n                'interval_days', 7,\n                'schedule_amounts', jsonb_build_array(\n                    (v_price / 5),\n                    (v_price / 5),\n                    (v_price / 5),\n                    (v_price / 5),\n                    v_price - ((v_price / 5) * 4)\n                )\n            )\n        );\n    END IF;\n\n    UPDATE public.course_access_enrollments\n    SET\n        status = CASE WHEN p_instant_free_unlock OR v_price = 0 THEN 'ACTIVE' ELSE 'APPROVED_TO_BUY' END,\n        total_price = v_price,\n        due_amount = CASE WHEN p_instant_free_unlock OR v_price = 0 THEN 0 ELSE GREATEST(v_price - paid_amount, 0) END,\n        next_installment_amount = CASE WHEN p_instant_free_unlock OR v_price = 0 THEN 0 ELSE GREATEST(v_price - paid_amount, 0) END,\n        installment_enabled = COALESCE(p_installment_enabled, TRUE),\n        installment_plans_json = v_plans,\n        admin_note = COALESCE(p_admin_note, ''),\n        rejection_reason = '',\n        approved_at = NOW(),\n        unlocked_at = CASE WHEN p_instant_free_unlock OR v_price = 0 THEN NOW() ELSE unlocked_at END,\n        updated_at = NOW()\n    WHERE id = p_enrollment_id;\n\n    RETURN jsonb_build_object('success', TRUE);\nEND;\n$function$\n",
        "admin_set_device_course_permissions": "CREATE OR REPLACE FUNCTION public.admin_set_device_course_permissions(p_device_hash text, p_is_restricted boolean, p_allowed_classes text[] DEFAULT '{}'::text[], p_allowed_groups text[] DEFAULT '{}'::text[], p_allowed_batches text[] DEFAULT '{}'::text[], p_allowed_programs text[] DEFAULT '{}'::text[])\n RETURNS json\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nBEGIN\n    UPDATE public.devices\n    SET is_access_restricted = COALESCE(p_is_restricted, false),\n        allowed_classes = COALESCE(p_allowed_classes, '{}'::TEXT[]),\n        allowed_groups = COALESCE(p_allowed_groups, '{}'::TEXT[]),\n        allowed_batches = COALESCE(p_allowed_batches, '{}'::TEXT[]),\n        allowed_programs = COALESCE(p_allowed_programs, '{}'::TEXT[]),\n        updated_at = now()\n    WHERE device_hash = p_device_hash OR display_device_id = p_device_hash;\n\n    UPDATE public.activated_devices\n    SET is_access_restricted = COALESCE(p_is_restricted, false),\n        allowed_classes = COALESCE(p_allowed_classes, '{}'::TEXT[]),\n        allowed_groups = COALESCE(p_allowed_groups, '{}'::TEXT[]),\n        allowed_batches = COALESCE(p_allowed_batches, '{}'::TEXT[]),\n        allowed_programs = COALESCE(p_allowed_programs, '{}'::TEXT[])\n    WHERE device_hash = p_device_hash;\n\n    RETURN json_build_object(\n        'success', true,\n        'message', 'ডিভাইসের কোর্স ও সিলেবাস পারমিশন সফলভাবে আপডেট করা হয়েছে!'\n    );\nEND;\n$function$\n",
        "enforce_overdue_course_installments": "CREATE OR REPLACE FUNCTION public.enforce_overdue_course_installments()\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_overdue_count INT := 0;\n    v_trial_expired_count INT := 0;\nBEGIN\n    UPDATE public.course_access_enrollments\n    SET status = 'INSTALLMENT_OVERDUE',\n        updated_at = NOW()\n    WHERE status IN ('ACTIVE', 'INSTALLMENT_ACTIVE', 'PARTIAL_PAID')\n      AND (\n          (due_amount > 0 AND next_due_date IS NOT NULL AND next_due_date <= NOW())\n          OR (installment_due_at IS NOT NULL AND installment_due_at <= NOW())\n      );\n    GET DIAGNOSTICS v_overdue_count = ROW_COUNT;\n\n    UPDATE public.course_access_enrollments\n    SET status = 'TRIAL_EXPIRED',\n        updated_at = NOW()\n    WHERE status = 'TRIAL_ACTIVE'\n      AND trial_expires_at IS NOT NULL\n      AND trial_expires_at <= NOW();\n    GET DIAGNOSTICS v_trial_expired_count = ROW_COUNT;\n\n    RETURN jsonb_build_object(\n        'success', true,\n        'overdue_updated', v_overdue_count,\n        'trials_expired', v_trial_expired_count\n    );\nEND;\n$function$\n",
        "admin_set_account_course_permissions": "CREATE OR REPLACE FUNCTION public.admin_set_account_course_permissions(p_device_hash text, p_shikho_user_id text, p_user_phone text DEFAULT ''::text, p_is_access_granted boolean DEFAULT true, p_is_restricted boolean DEFAULT true, p_allowed_classes text[] DEFAULT '{}'::text[], p_allowed_groups text[] DEFAULT '{}'::text[], p_allowed_batches text[] DEFAULT '{}'::text[], p_allowed_programs text[] DEFAULT '{}'::text[], p_revoke_other_accounts boolean DEFAULT true)\n RETURNS json\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nBEGIN\n    IF p_revoke_other_accounts = true AND p_is_access_granted = true THEN\n        UPDATE public.device_shikho_accounts\n        SET is_access_granted = false,\n            is_access_restricted = false,\n            allowed_classes = '{}'::TEXT[],\n            allowed_groups = '{}'::TEXT[],\n            allowed_batches = '{}'::TEXT[],\n            allowed_programs = '{}'::TEXT[]\n        WHERE (device_hash = p_device_hash OR display_device_id = p_device_hash)\n          AND shikho_user_id <> p_shikho_user_id;\n    END IF;\n\n    INSERT INTO public.device_shikho_accounts (\n        device_hash, display_device_id, shikho_user_id, user_phone,\n        is_access_granted, is_access_restricted,\n        allowed_classes, allowed_groups, allowed_batches, allowed_programs, last_seen_at\n    ) VALUES (\n        p_device_hash, p_device_hash, p_shikho_user_id, COALESCE(p_user_phone, ''),\n        COALESCE(p_is_access_granted, true), COALESCE(p_is_restricted, true),\n        COALESCE(p_allowed_classes, '{}'::TEXT[]), COALESCE(p_allowed_groups, '{}'::TEXT[]),\n        COALESCE(p_allowed_batches, '{}'::TEXT[]), COALESCE(p_allowed_programs, '{}'::TEXT[]), now()\n    )\n    ON CONFLICT (device_hash, shikho_user_id) DO UPDATE SET\n        user_phone = COALESCE(NULLIF(EXCLUDED.user_phone, ''), public.device_shikho_accounts.user_phone),\n        is_access_granted = EXCLUDED.is_access_granted,\n        is_access_restricted = EXCLUDED.is_access_restricted,\n        allowed_classes = EXCLUDED.allowed_classes,\n        allowed_groups = EXCLUDED.allowed_groups,\n        allowed_batches = EXCLUDED.allowed_batches,\n        allowed_programs = EXCLUDED.allowed_programs,\n        last_seen_at = now();\n\n    IF p_is_access_granted = true THEN\n        UPDATE public.devices\n        SET is_access_restricted = COALESCE(p_is_restricted, true),\n            bound_shikho_user_id = p_shikho_user_id,\n            bound_user_phone = COALESCE(p_user_phone, ''),\n            allowed_classes = COALESCE(p_allowed_classes, '{}'::TEXT[]),\n            allowed_groups = COALESCE(p_allowed_groups, '{}'::TEXT[]),\n            allowed_batches = COALESCE(p_allowed_batches, '{}'::TEXT[]),\n            allowed_programs = COALESCE(p_allowed_programs, '{}'::TEXT[]),\n            updated_at = now()\n        WHERE device_hash = p_device_hash OR device_id = p_device_hash OR display_device_id = p_device_hash;\n    END IF;\n\n    RETURN json_build_object(\n        'success', true,\n        'message', 'নির্দিষ্ট শিখো অ্যাকাউন্টের জন্য সিলেবাস ও কোর্স এক্সেস সফলভাবে সেট করা হয়েছে!'\n    );\nEND;\n$function$\n",
        "admin_approve_course_access_with_trial": "CREATE OR REPLACE FUNCTION public.admin_approve_course_access_with_trial(p_student_key text, p_program_id text, p_total_price numeric, p_allow_installments boolean DEFAULT false, p_installment_plans jsonb DEFAULT '[]'::jsonb, p_trial_enabled boolean DEFAULT false, p_trial_days integer DEFAULT 0, p_trial_hours integer DEFAULT 0, p_start_trial_immediately boolean DEFAULT false, p_admin_note text DEFAULT ''::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_now TIMESTAMPTZ := now();\n    v_total_hours INTEGER;\n    v_trial_started TIMESTAMPTZ := NULL;\n    v_trial_ends TIMESTAMPTZ := NULL;\n    v_status TEXT := 'APPROVED_TO_BUY';\n    v_norm_key TEXT;\nBEGIN\n    v_norm_key := public.normalize_bd_phone(p_student_key);\n    v_total_hours := GREATEST(0, (COALESCE(p_trial_days, 0) * 24) + COALESCE(p_trial_hours, 0));\n\n    IF p_trial_enabled AND p_start_trial_immediately AND v_total_hours > 0 THEN\n        v_trial_started := v_now;\n        v_trial_ends := v_now + (v_total_hours || ' hours')::INTERVAL;\n        v_status := 'TRIAL_ACTIVE';\n    END IF;\n\n    UPDATE public.course_access_enrollments\n    SET status = v_status,\n        total_price = COALESCE(p_total_price, 0)::INTEGER,\n        due_amount = GREATEST(0, COALESCE(p_total_price, 0)::INTEGER - COALESCE(paid_amount, 0)),\n        allow_installments = COALESCE(p_allow_installments, false),\n        installment_enabled = COALESCE(p_allow_installments, false),\n        installment_plans_json = CASE WHEN p_installment_plans IS NOT NULL AND jsonb_typeof(p_installment_plans) = 'array' AND jsonb_array_length(p_installment_plans) > 0 THEN p_installment_plans ELSE installment_plans_json END,\n        trial_enabled = COALESCE(p_trial_enabled, false),\n        trial_days = GREATEST(0, COALESCE(p_trial_days, 0)),\n        trial_hours = GREATEST(0, COALESCE(p_trial_hours, 0)),\n        trial_started_at = CASE\n            WHEN p_start_trial_immediately AND v_total_hours > 0 THEN v_trial_started\n            WHEN NOT p_trial_enabled THEN NULL\n            ELSE trial_started_at\n        END,\n        trial_ends_at = CASE\n            WHEN p_start_trial_immediately AND v_total_hours > 0 THEN v_trial_ends\n            WHEN NOT p_trial_enabled THEN NULL\n            ELSE trial_ends_at\n        END,\n        is_trial_used = CASE\n            WHEN p_start_trial_immediately AND v_total_hours > 0 THEN true\n            WHEN p_trial_enabled THEN false\n            ELSE is_trial_used\n        END,\n        admin_note = COALESCE(p_admin_note, admin_note),\n        approved_at = COALESCE(approved_at, v_now),\n        updated_at = v_now\n    WHERE (\n        shikho_account_key = p_student_key\n        OR student_key = p_student_key\n        OR device_id = p_student_key\n        OR id::text = p_student_key\n        OR (v_norm_key <> '' AND public.normalize_bd_phone(student_phone) = v_norm_key)\n    )\n    AND program_id = p_program_id;\n\n    RETURN jsonb_build_object(\n        'success', true,\n        'status', v_status,\n        'trial_ends_at', v_trial_ends\n    );\nEND;\n$function$\n",
        "trg_fn_course_payments_onesignal_notify": "CREATE OR REPLACE FUNCTION public.trg_fn_course_payments_onesignal_notify()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_device_hash TEXT;\n    v_player_id TEXT;\n    v_phone TEXT;\n    v_title TEXT;\n    v_prog_id TEXT;\nBEGIN\n    BEGIN\n        SELECT COALESCE(NULLIF(device_hash, ''), device_id), onesignal_player_id, student_phone\n        INTO v_device_hash, v_player_id, v_phone\n        FROM public.course_access_enrollments\n        WHERE id = NEW.enrollment_id\n        LIMIT 1;\n\n        v_phone := COALESCE(NULLIF(v_phone, ''), NULLIF(NEW.sender_mobile, ''), NULLIF(NEW.user_phone, ''), '');\n        v_title := COALESCE(NULLIF(NEW.program_title, ''), NULLIF(NEW.course_title, ''), 'কোর্স');\n        v_prog_id := COALESCE(NULLIF(NEW.program_id, ''), NULLIF(NEW.course_id, ''), '');\n\n        IF TG_OP = 'INSERT' AND NEW.status = 'PENDING' THEN\n            PERFORM public.notify_admin_via_onesignal(\n                '💰 নতুন কোর্স পেমেন্ট সাবমিট হয়েছে!',\n                v_phone || ' - \"' || v_title || '\" কোর্সের জন্য ৳' || COALESCE(NEW.amount, 0)::INT || ' (' || COALESCE(NEW.payment_method, 'bKash') || ' TrxID: ' || COALESCE(NEW.transaction_id, '') || ') পাঠিয়েছে।',\n                'ADMIN_COURSE_PAYMENT_SUBMITTED',\n                jsonb_build_object(\n                    'payment_id', NEW.id,\n                    'enrollment_id', NEW.enrollment_id,\n                    'program_id', v_prog_id,\n                    'course_id', v_prog_id,\n                    'transaction_id', NEW.transaction_id\n                )\n            );\n        END IF;\n\n        IF TG_OP = 'UPDATE' AND OLD.status IS DISTINCT FROM NEW.status THEN\n            IF NEW.status = 'APPROVED' THEN\n                PERFORM public.notify_student_via_onesignal(\n                    v_player_id,\n                    v_device_hash,\n                    v_phone,\n                    '✅ পেমেন্ট ভেরিফাই ও অনুমোদিত হয়েছে!',\n                    'আপনার ৳' || COALESCE(NEW.amount, 0)::INT || ' পেমেন্ট (TrxID: ' || COALESCE(NEW.transaction_id, '') || ') অনুমোদিত হয়েছে এবং \"' || v_title || '\" আনলক করা হয়েছে!',\n                    'COURSE_PAYMENT_APPROVED',\n                    jsonb_build_object('program_id', v_prog_id, 'course_id', v_prog_id, 'payment_id', NEW.id)\n                );\n            ELSIF NEW.status = 'REJECTED' THEN\n                PERFORM public.notify_student_via_onesignal(\n                    v_player_id,\n                    v_device_hash,\n                    v_phone,\n                    '❌ পেমেন্ট ভেরিফিকেশন বাতিল হয়েছে',\n                    'আপনার ৳' || COALESCE(NEW.amount, 0)::INT || ' পেমেন্ট (TrxID: ' || COALESCE(NEW.transaction_id, '') || ') বাতিল হয়েছে। কারণ: ' || COALESCE(NULLIF(NEW.rejection_reason, ''), 'সঠিক TrxID দিয়ে পুনরায় চেষ্টা করুন।'),\n                    'COURSE_PAYMENT_REJECTED',\n                    jsonb_build_object('program_id', v_prog_id, 'course_id', v_prog_id, 'payment_id', NEW.id)\n                );\n            END IF;\n        END IF;\n    EXCEPTION WHEN OTHERS THEN\n        RAISE WARNING 'trg_fn_course_payments_onesignal_notify skipped error: %', SQLERRM;\n    END;\n\n    RETURN NEW;\nEND;\n$function$\n",
        "trg_fn_course_enrollments_onesignal_notify": "CREATE OR REPLACE FUNCTION public.trg_fn_course_enrollments_onesignal_notify()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nDECLARE\n    v_title TEXT;\n    v_id TEXT;\nBEGIN\n    BEGIN\n        v_title := COALESCE(NULLIF(NEW.program_title, ''), NULLIF(NEW.course_title, ''), 'কোর্স');\n        v_id := COALESCE(NULLIF(NEW.program_id, ''), NULLIF(NEW.course_id, ''), '');\n\n        IF (TG_OP = 'INSERT' AND NEW.status = 'REQUESTED')\n           OR (TG_OP = 'UPDATE' AND OLD.status IS DISTINCT FROM NEW.status AND NEW.status = 'REQUESTED') THEN\n            PERFORM public.notify_admin_via_onesignal(\n                '📚 নতুন কোর্স এক্সেস রিকোয়েস্ট!',\n                COALESCE(NULLIF(NEW.student_name, ''), NEW.student_phone, 'শিক্ষার্থী') || ' - \"' || v_title || '\" কোর্সে এক্সেস রিকোয়েস্ট পাঠিয়েছে।',\n                'ADMIN_COURSE_ACCESS_REQUEST',\n                jsonb_build_object(\n                    'enrollment_id', NEW.id,\n                    'program_id', v_id,\n                    'course_id', v_id,\n                    'program_title', v_title,\n                    'student_phone', NEW.student_phone\n                )\n            );\n        END IF;\n\n        IF TG_OP = 'UPDATE' AND COALESCE(OLD.is_trial_used, FALSE) = FALSE AND COALESCE(NEW.is_trial_used, FALSE) = TRUE THEN\n            PERFORM public.notify_admin_via_onesignal(\n                '🎁 ফ্রি ট্রায়াল শুরু হয়েছে!',\n                COALESCE(NULLIF(NEW.student_name, ''), NEW.student_phone, 'শিক্ষার্থী') || ' - \"' || v_title || '\" কোর্সে ফ্রি ট্রায়াল চালু করেছে।',\n                'ADMIN_FREE_TRIAL_STARTED',\n                jsonb_build_object(\n                    'enrollment_id', NEW.id,\n                    'program_id', v_id,\n                    'course_id', v_id,\n                    'student_phone', NEW.student_phone\n                )\n            );\n        END IF;\n\n        IF TG_OP = 'UPDATE' AND OLD.status IS DISTINCT FROM NEW.status THEN\n            IF NEW.status IN ('APPROVED_TO_BUY', 'APPROVED_UNPAID') THEN\n                PERFORM public.notify_student_via_onesignal(\n                    NEW.onesignal_player_id,\n                    COALESCE(NULLIF(NEW.device_hash, ''), NEW.device_id),\n                    NEW.student_phone,\n                    '🎉 কোর্স রিকোয়েস্ট অনুমোদিত হয়েছে!',\n                    '\"' || v_title || '\"-এর রিকোয়েস্ট অনুমোদিত হয়েছে (মূল্য: ৳' || COALESCE(NEW.total_price, 0)::INT || CASE WHEN COALESCE(NEW.trial_enabled, FALSE) AND COALESCE(NEW.trial_days, 0) > 0 THEN ', সাথে ' || NEW.trial_days || ' দিনের ফ্রি ট্রায়াল!' ELSE '' END || ')।',\n                    'COURSE_ACCESS_APPROVED',\n                    jsonb_build_object('program_id', v_id, 'course_id', v_id, 'status', NEW.status)\n                );\n            ELSIF NEW.status = 'ACTIVE' AND OLD.status <> 'ACTIVE' THEN\n                PERFORM public.notify_student_via_onesignal(\n                    NEW.onesignal_player_id,\n                    COALESCE(NULLIF(NEW.device_hash, ''), NEW.device_id),\n                    NEW.student_phone,\n                    '✅ কোর্স আনলক হয়েছে!',\n                    'আপনার \"' || v_title || '\" কোর্সটি আনলক করা হয়েছে। এখন ক্লাস শুরু করতে পারেন!',\n                    'COURSE_UNLOCKED',\n                    jsonb_build_object('program_id', v_id, 'course_id', v_id, 'status', NEW.status)\n                );\n            ELSIF NEW.status IN ('REJECTED', 'LOCKED', 'REVOKED') THEN\n                PERFORM public.notify_student_via_onesignal(\n                    NEW.onesignal_player_id,\n                    COALESCE(NULLIF(NEW.device_hash, ''), NEW.device_id),\n                    NEW.student_phone,\n                    '❌ কোর্স রিকোয়েস্ট বাতিল বা লক হয়েছে',\n                    '\"' || v_title || '\" কোর্সের এক্সেস স্থগিত বা বাতিল করা হয়েছে। ' || COALESCE(NEW.admin_note, ''),\n                    'COURSE_ACCESS_REJECTED',\n                    jsonb_build_object('program_id', v_id, 'course_id', v_id, 'status', NEW.status)\n                );\n            END IF;\n        END IF;\n\n        IF TG_OP = 'UPDATE'\n           AND (OLD.trial_days IS DISTINCT FROM NEW.trial_days OR OLD.trial_ends_at IS DISTINCT FROM NEW.trial_ends_at)\n           AND OLD.status = NEW.status THEN\n            PERFORM public.notify_student_via_onesignal(\n                NEW.onesignal_player_id,\n                COALESCE(NULLIF(NEW.device_hash, ''), NEW.device_id),\n                NEW.student_phone,\n                '⏳ ফ্রি ট্রায়ালের সময় আপডেট হয়েছে!',\n                '\"' || v_title || '\" কোর্সের ফ্রি ট্রায়ালের মেয়াদ অ্যাডমিন আপডেট করেছেন।',\n                'COURSE_TRIAL_UPDATED',\n                jsonb_build_object('program_id', v_id, 'course_id', v_id, 'trial_days', NEW.trial_days)\n            );\n        END IF;\n    EXCEPTION WHEN OTHERS THEN\n        RAISE WARNING 'trg_fn_course_enrollments_onesignal_notify skipped error: %', SQLERRM;\n    END;\n\n    RETURN NEW;\nEND;\n$function$\n"
    }
